---
/**
 * Post sidebar — search, categories, recent posts and a tag cloud.
 *
 * Every link points back at `/blog` with a query string; the archive page
 * reads those params and filters the grid, so the whole thing works from
 * static HTML with no search index and no dependencies.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Id of the post being read, so it is left out of "recent posts". */
  currentId?: string;
  class?: string;
}

const { posts, currentId, class: className = '' } = Astro.props;

const byDate = [...posts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [...
  byDate.reduce((map, p) => {
    map.set(p.data.category, (map.get(p.data.category) ?? 0) + 1);
    return map;
  }, new Map<string, number>()),
].sort((a, b) => a[0].localeCompare(b[0]));

const tags = [...new Set(byDate.flatMap((p) => p.data.tags))].sort((a, b) =>
  a.localeCompare(b),
);

const recent = byDate.filter((p) => p.id !== currentId).slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<aside class:list={['sidebar', className]} aria-label="Blog sidebar">
  <!-- Search ------------------------------------------------------------ -->
  <section class="widget" data-anim="up">
    <h2 class="widget__title">Search</h2>
    <form class="widget__search" action="/blog" method="get" role="search">
      <label class="visually-hidden" for="blog-search">Search posts</label>
      <input
        id="blog-search"
        type="search"
        name="q"
        placeholder="Search posts…"
        autocomplete="off"
      />
      <button type="submit" aria-label="Search">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="5" />
          <path d="m10.8 10.8 3.2 3.2" />
        </svg>
      </button>
    </form>
  </section>

  <!-- Categories -------------------------------------------------------- -->
  <section class="widget" data-anim="up" data-anim-delay="0.1">
    <h2 class="widget__title">Categories</h2>
    <ul class="widget__list">
      {
        categories.map(([name, count]) => (
          <li>
            <a href={`/blog?category=${encodeURIComponent(name)}`}>
              <span>{name}</span>
              <span class="widget__count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Recent posts ------------------------------------------------------ -->
  <section class="widget" data-anim="up" data-anim-delay="0.2">
    <h2 class="widget__title">Recent Posts</h2>
    <ul class="widget__recent">
      {
        recent.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <img
                src={post.data.image}
                alt=""
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
              />
              <span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFmt.format(post.data.pubDate)}
                </time>
                <h3>{post.data.title}</h3>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Tags -------------------------------------------------------------- -->
  <section class="widget" data-anim="up" data-anim-delay="0.3">
    <h2 class="widget__title">Tags</h2>
    <ul class="widget__tags">
      {
        tags.map((tag) => (
          <li>
            <a href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>
          </li>
        ))
      }
    </ul>
  </section>
</aside>

<style>
  .sidebar {
    display: grid;
    gap: 1.875rem;
    align-content: start;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .widget {
    padding: 1.875rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
  }

  .widget__title {
    margin: 0 0 1.25rem;
    padding-bottom: 0.875rem;
    font-size: var(--text-h4);
    border-bottom: 1px solid var(--color-border);
  }

  /* ------------------------------------------------------------- search */
  .widget__search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.3125rem 0.3125rem 1.125rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }
  .widget__search input {
    flex: 1;
    min-width: 0;
    padding: 0.625rem 0;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-heading);
    background: none;
    border: 0;
  }
  .widget__search input::placeholder { color: var(--color-text); }
  .widget__search input:focus { outline: none; }
  .widget__search:focus-within {
    border-color: var(--color-accent);
  }
  .widget__search button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: 50%;
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .widget__search button:hover {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }
  .widget__search svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* --------------------------------------------------------- categories */
  .widget__list { display: grid; gap: 0.25rem; }
  .widget__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.875rem;
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .widget__list a:hover {
    color: var(--color-on-accent);
    background: var(--color-accent);
  }
  .widget__count {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .widget__list a:hover .widget__count { color: var(--color-on-accent); }

  /* ------------------------------------------------------ recent posts */
  .widget__recent { display: grid; gap: 1.125rem; }
  .widget__recent a {
    display: flex;
    align-items: center;
    gap: 0.9375rem;
  }
  .widget__recent img {
    width: 4.375rem;
    height: 4.375rem;
    flex: none;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .widget__recent time {
    display: block;
    margin-bottom: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .widget__recent h3 {
    margin: 0;
    font-size: var(--text-h6);
    line-height: 1.3;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .widget__recent a:hover h3 { color: var(--color-primary); }

  /* ---------------------------------------------------------------- tags */
  .widget__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .widget__tags a {
    display: inline-block;
    padding: 0.4375rem 1rem;
    font-size: var(--text-sm);
    color: var(--color-heading);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .widget__tags a:hover {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (max-width: 26rem) {
    .widget { padding: 1.25rem; }
  }
</style>
