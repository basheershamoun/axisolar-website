---
/**
 * Contact details: four image cards (address / email / phone / socials) with a
 * floating info panel, followed by a lazily-embedded map.
 * Every detail is read from src/data/site.ts — nothing is hardcoded here.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { site, socials } from '../../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  /** Hide the map when this section is reused on a page that already has one. */
  showMap?: boolean;
}

const {
  eyebrow = 'Contact Details',
  title = 'Happy to Answer All Your Questions',
  showMap = true,
} = Astro.props;

interface InfoLine { text: string; href?: string }
interface InfoCard {
  key: string;
  icon: 'pin' | 'mail' | 'phone';
  image: string;
  alt: string;
  heading: string;
  lines: InfoLine[];
}

const cards: InfoCard[] = [
  {
    key: 'address',
    icon: 'pin',
    image: '/images/location-img.jpg',
    alt: 'A city map open on a laptop with location pins dropped on it',
    heading: 'Our Address:',
    lines: [{ text: site.address }, { text: site.hours }],
  },
  {
    key: 'email',
    icon: 'mail',
    image: '/images/email-img.jpg',
    alt: 'An email inbox open on a laptop screen',
    heading: 'Email Us:',
    lines: [{ text: site.email, href: `mailto:${site.email}` }],
  },
  {
    key: 'phone',
    icon: 'phone',
    image: '/images/phone-img.jpg',
    alt: 'A support agent wearing a headset',
    heading: 'Call Us:',
    lines: [{ text: site.phone, href: `tel:${site.phoneHref}` }],
  },
];

/** Map query: the office address straight from site.ts. */
const mapQuery = encodeURIComponent(site.address);
const mapSrc = `https://maps.google.com/maps?q=${mapQuery}&t=m&z=15&output=embed&iwloc=near`;

const socialPaths: Record<string, string> = {
  facebook:
    'M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0 0 3.603 0 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.01c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z',
  x: 'M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.6.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z',
  linkedin:
    'M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z',
  instagram:
    'M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z',
};
---

<section class="section cinfo" aria-label="Contact details">
  <div class="container-site">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      align="center"
      class="cinfo__head"
    />

    <ul class="cinfo__grid">
      {
        cards.map((card, i) => (
          <li class="cinfo__card" data-anim="up" data-anim-delay={(i * 0.12).toFixed(2)}>
            <div class="cinfo__media">
              <img src={card.image} alt={card.alt} loading="lazy" decoding="async" width="420" height="320" />
              <span class="cinfo__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  {card.icon === 'pin' && (
                    <>
                      <path d="M20 10c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 1 1 16 0Z" />
                      <circle cx="12" cy="10" r="3" />
                    </>
                  )}
                  {card.icon === 'mail' && (
                    <>
                      <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                      <path d="m3.5 6.5 8.5 6 8.5-6" />
                    </>
                  )}
                  {card.icon === 'phone' && (
                    <path d="M6.6 3.5h-.9A2.7 2.7 0 0 0 3 6.2C3 14 10 21 17.8 21a2.7 2.7 0 0 0 2.7-2.7v-.9a1 1 0 0 0-.7-.95l-3.4-1.1a1 1 0 0 0-1.1.35l-.9 1.15a12.6 12.6 0 0 1-5.3-5.3l1.15-.9a1 1 0 0 0 .35-1.1L9.5 4.2a1 1 0 0 0-.95-.7Z" />
                  )}
                </svg>
              </span>
            </div>

            <div class="cinfo__body">
              <h3 class="cinfo__title">{card.heading}</h3>
              {card.lines.map((line) => (
                <p class="cinfo__line">
                  {line.href ? <a href={line.href}>{line.text}</a> : line.text}
                </p>
              ))}
            </div>
          </li>
        ))
      }

      <li class="cinfo__card" data-anim="up" data-anim-delay="0.36">
        <div class="cinfo__media">
          <img
            src="/images/follow-img.jpg"
            alt="A phone screen surrounded by floating social media app icons"
            loading="lazy"
            decoding="async"
            width="420"
            height="320"
          />
          <span class="cinfo__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3" />
              <circle cx="6" cy="12" r="3" />
              <circle cx="18" cy="19" r="3" />
              <path d="m8.6 10.6 6.8-4M8.6 13.4l6.8 4" />
            </svg>
          </span>
        </div>

        <div class="cinfo__body">
          <h3 class="cinfo__title">Follow Us:</h3>
          <ul class="cinfo__socials">
            {socials.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d={socialPaths[s.icon]} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    </ul>

    {
      showMap && (
        <div class="cinfo__map" data-anim="up">
          <iframe
            src={mapSrc}
            title={`Map showing the Solor office at ${site.address}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .cinfo__head {
    margin-bottom: 3.5rem;
  }

  .cinfo__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.875rem;
  }

  .cinfo__card {
    position: relative;
    padding-bottom: 1rem;
  }

  .cinfo__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cinfo__media img {
    width: 100%;
    height: 17rem;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .cinfo__card:hover .cinfo__media img {
    transform: scale(1.06);
  }

  .cinfo__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .cinfo__badge svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* White panel floats over the bottom of the image, as in the original. */
  .cinfo__body {
    position: relative;
    margin: -5rem 0.75rem 0;
    padding: 1.25rem 1.25rem 1.375rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .cinfo__title {
    margin-bottom: 0.5rem;
    font-size: var(--text-h6);
    color: var(--color-heading);
  }
  .cinfo__line {
    margin-bottom: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .cinfo__line a:hover {
    color: var(--color-accent);
  }

  .cinfo__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cinfo__socials a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .cinfo__socials a:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .cinfo__socials svg {
    width: 1rem;
    height: 1rem;
  }

  .cinfo__map {
    margin-top: 3.75rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    line-height: 0;
    background: var(--color-bg-alt);
  }
  .cinfo__map iframe {
    display: block;
    width: 100%;
    height: 28rem;
    border: 0;
  }

  @media (max-width: 1199px) {
    .cinfo__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 575px) {
    .cinfo__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .cinfo__media img {
      height: 14rem;
    }
    .cinfo__map iframe {
      height: 20rem;
    }
  }
</style>
