---
/**
 * FAQ accordion.
 *
 * Built on native <details>/<summary>, so it is fully operable with zero
 * JavaScript: keyboard, screen-reader expanded state and single-open
 * behaviour all come from the browser. Single-open without JS is the `name`
 * attribute on <details> (browsers that don't support it simply allow more
 * than one panel open — a graceful degradation, not a break).
 *
 * The script below is pure enhancement: it swaps the instant native toggle
 * for a height transition and takes over the single-open grouping so the
 * closing panel can animate too. It bails out under prefers-reduced-motion,
 * leaving the native behaviour untouched.
 */
import type { Faq } from '../../data/faqs';

interface Props {
  items: Faq[];
  /** Shared name = only one panel open at a time, natively, without JS. */
  name?: string;
  /** Open the first item on load, as the original page does. */
  openFirst?: boolean;
  class?: string;
}

const { items, name = 'faq', openFirst = true, class: className = '' } = Astro.props;
---

<div class:list={['faq', className]} data-faq>
  {
    items.map((item, i) => (
      <details
        class="faq__item"
        name={name}
        open={openFirst && i === 0}
        data-anim="up"
        data-anim-delay={(Math.min(i, 6) * 0.06).toFixed(2)}
      >
        <summary class="faq__q">
          <span class="faq__q-text">{item.question}</span>
          <span class="faq__icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </summary>
        <div class="faq__panel">
          <div class="faq__answer">
            <p>{item.answer}</p>
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 61.25rem;
    margin-inline: auto;
  }

  .faq__item {
    border-radius: var(--radius-pill);
    background: var(--color-bg-alt);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .faq__item[open] {
    background: transparent;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.0625rem 1.5rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-h6);
    font-weight: var(--weight-bold);
    line-height: 1.35;
    color: var(--color-heading);
    background: var(--color-bg-alt);
    border-radius: var(--radius-pill);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  /* Kill the native disclosure triangle in every engine. */
  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    background: var(--color-parchment);
  }

  .faq__item[open] > .faq__q,
  .faq__item[open] > .faq__q:hover {
    background: var(--color-accent);
    /* White on lime is 1.50:1 — unreadable. Forest on lime is 9.28:1 and is
       what every other active-on-accent state in the system already uses. */
    color: var(--color-on-accent);
  }

  .faq__icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .faq__icon svg {
    width: 100%;
    height: 100%;
  }
  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
  }

  /* The panel is the animated box: it owns overflow, the answer inside owns
     the padding, so the measured height never changes mid-transition. */
  .faq__panel {
    overflow: hidden;
  }
  .faq__answer {
    padding: 1.375rem 1.5rem 0.75rem;
    color: var(--color-text);
    font-size: var(--text-base);
  }

  @media (max-width: 575px) {
    .faq__item,
    .faq__q {
      border-radius: var(--radius-lg);
    }
    .faq__q {
      padding: 1rem 1.125rem;
      font-size: var(--text-base);
    }
    .faq__answer {
      padding-inline: 1.125rem;
    }
  }
</style>

<script>
  const EASE = 'cubic-bezier(0.215, 0.61, 0.355, 1)';
  const DURATION = 320;

  function enhanceAccordion(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('details.faq__item'));
    if (!items.length) return;

    // JS now owns single-open grouping, so drop the native grouping that would
    // otherwise slam siblings shut before they can animate.
    items.forEach((d) => d.removeAttribute('name'));

    items.forEach((details) => {
      const summary = details.querySelector<HTMLElement>('summary');
      const panel = details.querySelector<HTMLElement>('.faq__panel');
      if (!summary || !panel) return;

      let anim: Animation | null = null;

      const slide = (from: number, to: number, onDone?: () => void) => {
        anim?.cancel();
        panel.style.height = `${from}px`;
        anim = panel.animate(
          { height: [`${from}px`, `${to}px`] },
          { duration: DURATION, easing: EASE },
        );
        anim.onfinish = () => {
          panel.style.height = '';
          anim = null;
          onDone?.();
        };
        anim.oncancel = () => {
          panel.style.height = '';
        };
      };

      const open = () => {
        details.open = true;
        slide(0, panel.scrollHeight);
      };

      const close = () => {
        slide(panel.offsetHeight, 0, () => {
          details.open = false;
        });
      };

      summary.addEventListener('click', (event) => {
        event.preventDefault();

        if (details.open) {
          close();
          return;
        }

        items.forEach((other) => {
          if (other !== details && other.open) {
            other.dispatchEvent(new CustomEvent('faq:close'));
          }
        });
        open();
      });

      details.addEventListener('faq:close', close);
    });
  }

  function initFaqAccordions() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-faq]').forEach(enhanceAccordion);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqAccordions, { once: true });
  } else {
    initFaqAccordions();
  }
</script>
