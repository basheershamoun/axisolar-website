---
/**
 * "Our Latest News" — the three most recent posts.
 *
 * Sourced from the `blog` content collection rather than a local array. An
 * earlier hardcoded copy had drifted from the real posts (a category read
 * "Renewable Power" against the post's "Renewable Energy", one date was a day
 * out, and titles differed in casing), so the homepage advertised metadata the
 * article itself contradicted. Reading the collection makes that impossible.
 */
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((entry) => ({
    title: entry.data.title,
    slug: entry.id,
    image: entry.data.image,
    imageAlt: entry.data.imageAlt ?? '',
    category: entry.data.category,
    datetime: entry.data.pubDate.toISOString().slice(0, 10),
    date: entry.data.pubDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }),
  }));
---

<section class="blog section" aria-label="Latest news">
  <div class="container-site">
    <div class="blog__head">
      <SectionHeading
        eyebrow="Recent articles"
        title="Our Latest News"
        align="center"
        as="h2"
      />
    </div>

    <ul class="blog__grid">
      {
        posts.map((post, i) => (
          <li class="blog__cell" data-anim="up" data-anim-delay={(i * 0.15).toFixed(2)}>
            <article class="post">
              {/* Decorative: the title link beside it is the real target, so
                  this stays out of the tab order entirely. */}
              <div class="post__media">
                <img
                  src={post.image}
                  alt=""
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="post__body">
                <p class="post__meta">
                  <time class="post__date" datetime={post.datetime}>{post.date}</time>
                  <span class="post__dot" aria-hidden="true" />
                  <span class="post__category">{post.category}</span>
                </p>

                <h3 class="post__title">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h3>

                <Button href={`/blog/${post.slug}`} variant="outline" class="post__cta">
                  Read More<span class="sr-only"> about {post.title}</span>
                </Button>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .blog { background: var(--color-bg); }

  .blog__head { margin-bottom: 3.125rem; }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.875rem;
  }

  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-parchment);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: box-shadow var(--dur-fast) var(--ease-out);
  }
  .post:hover { box-shadow: var(--shadow-card); }

  .post__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .post:hover .post__media img { transform: scale(1.06); }

  .post__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.875rem;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .post__dot {
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .post__category {
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }

  .post__title {
    margin: 0;
    font-size: var(--text-h4);
  }
  .post__title a { color: var(--color-heading); }
  .post__title a:hover { color: var(--color-primary); }

  .post__body :global(.post__cta) { margin-top: auto; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 991px) {
    .blog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 767px) {
    .blog__grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 575px) {
    .blog__head { margin-bottom: 2.25rem; }
    .post__body { padding: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post,
    .post__media img { transition: none; }
  }
</style>
