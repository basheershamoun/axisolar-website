---
/**
 * "Words From Our Customer" slider.
 *
 * Hand-rolled — no Swiper, no carousel dependency. The track is a plain
 * scroll-snap overflow container, so with JS disabled (or still loading) it
 * is already a working horizontal scroller with native keyboard and touch
 * support. The script only layers on the prev/next buttons and their
 * disabled state.
 */
import SectionHeading from '../ui/SectionHeading.astro';

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  image: string;
}

const quote =
  'Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.';

const testimonials: Testimonial[] = [
  { quote, name: 'John Doe',      role: 'Customer', image: '/images/author-1.jpg' },
  { quote, name: 'Arita Benson',  role: 'Customer', image: '/images/author-2.jpg' },
  { quote, name: 'W. S. Gilbert', role: 'Customer', image: '/images/author-3.jpg' },
];
---

<section class="tst section" aria-label="Customer testimonials">
  <div class="container-site">
    <div class="tst__head">
      <SectionHeading
        eyebrow="Testimonials"
        title="Words From Our Customer"
        as="h2"
        class="tst__heading"
      />

      <div class="tst__nav" data-js-only>
        <button type="button" class="tst__btn" data-slider-prev aria-label="Previous testimonial">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 8H3M7 4L3 8l4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="tst__btn" data-slider-next aria-label="Next testimonial">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    <!-- tabindex makes the overflow container keyboard-scrollable, which is
         what keeps this usable before/without the enhancement script. -->
    <ul
      class="tst__track"
      data-slider-track
      tabindex="0"
      role="list"
     
      aria-label="Customer testimonials"
    >
      {
        testimonials.map((item) => (
          <li class="tst__slide">
            <figure class="card">
              <span class="card__stars" role="img" aria-label="Rated 5 out of 5">
                {[0, 1, 2, 3, 4].map(() => (
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.7l5.9-.9L12 3.5Z" />
                  </svg>
                ))}
              </span>

              <blockquote class="card__quote">
                <p>{item.quote}</p>
              </blockquote>

              <figcaption class="card__author">
                <img
                  class="card__avatar"
                  src={item.image}
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                />
                <span class="card__meta">
                  <span class="card__name">{item.name}</span>
                  <span class="card__role">({item.role})</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  /** Minimal scroll-snap slider: measure one step, scroll, reflect state. */
  const sliders = document.querySelectorAll<HTMLElement>('.tst');

  sliders.forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-slider-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-slider-next]');
    if (!track || !prev || !next) return;

    root.classList.add('is-enhanced');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';

    /** One slide plus the flex gap — recomputed so it survives resizes. */
    const step = () => {
      const slide = track.querySelector<HTMLElement>('.tst__slide');
      if (!slide) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
      return slide.getBoundingClientRect().width + gap;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      // 1px slack: sub-pixel layout means scrollLeft rarely hits max exactly.
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    const go = (dir: 1 | -1) => track.scrollBy({ left: step() * dir, behavior });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(-1);
      }
    });

    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          sync();
        });
      },
      { passive: true },
    );

    if ('ResizeObserver' in window) {
      new ResizeObserver(sync).observe(track);
    } else {
      window.addEventListener('resize', sync);
    }

    sync();
  });
</script>

<style>
  .tst { background: var(--color-bg-alt); }

  .tst__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    margin-bottom: 3.125rem;
  }
  .tst__head :global(.tst__heading) { flex: 1 1 28rem; }

  /* Controls are useless without the script, so they stay hidden until it
     marks the section as enhanced. Native scrolling covers the no-JS case. */
  .tst__nav { display: none; gap: 0.75rem; }
  .tst.is-enhanced .tst__nav { display: flex; }

  .tst__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }
  .tst__btn svg { width: 1rem; height: 1rem; }
  .tst__btn:hover:not(:disabled) {
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .tst__btn:disabled {
    color: var(--color-text);
    background: transparent;
    border-color: var(--color-border);
    cursor: not-allowed;
  }

  .tst__track {
    display: flex;
    gap: 1.875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .tst__track::-webkit-scrollbar { height: 6px; }
  .tst__track::-webkit-scrollbar-track { background: var(--color-border); border-radius: var(--radius-pill); }
  .tst__track::-webkit-scrollbar-thumb { background: var(--color-accent); border-radius: var(--radius-pill); }

  .tst__slide {
    flex: 0 0 calc((100% - 1.875rem) / 2);
    scroll-snap-align: start;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    margin: 0;
    padding: 2.5rem;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
  }

  .card__stars { display: inline-flex; gap: 0.25rem; color: var(--color-accent); }
  .card__stars svg { width: 1.125rem; height: 1.125rem; }

  .card__quote { margin: 0; flex: 1 1 auto; }
  .card__quote p { color: var(--color-text); font-size: var(--text-base); }

  .card__author {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .card__avatar {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: 50%;
  }
  .card__meta { display: flex; flex-direction: column; }
  .card__name {
    font-family: var(--font-display);
    font-size: var(--text-h5);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }
  .card__role { font-size: var(--text-sm); color: var(--color-text); }

  @media (max-width: 991px) {
    .tst__slide { flex-basis: 100%; }
    .card { padding: 1.875rem; }
  }

  @media (max-width: 575px) {
    .tst__head { margin-bottom: 2.25rem; }
    .tst__track { gap: 1rem; }
    .card { padding: 1.5rem; gap: 1rem; }
    .card__avatar { width: 3.25rem; height: 3.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tst__track { scroll-behavior: auto; }
  }
</style>
