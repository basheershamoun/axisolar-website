---
/**
 * Single-project layout: sticky spec sidebar, lead image, body copy, gallery
 * and wrap-around prev/next navigation. Mirrors the original's two-column
 * `project-sidebar` / content split, collapsing to one column under 991px.
 */
import type { Project, SpecIcon } from '../../data/projects';

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;

/** Decorative glyphs for the sidebar rows — one path set per spec icon. */
const ICONS: Record<SpecIcon, string[]> = {
  date: ['M7 3v4M17 3v4M3 9h18', 'M4 5h16v16H4z'],
  energy: ['M13 3 5 14h6l-1 7 8-11h-6l1-7z'],
  category: ['M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z'],
  client: ['M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', 'M4 21a8 8 0 0 1 16 0'],
  location: ['M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z', 'M12 10.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z'],
};
---

<section class="section pdetail">
  <div class="container-site pdetail__layout">
    <!-- ---------------------------------------------------------------- -->
    <aside class="pdetail__aside" aria-labelledby="about-project" data-anim="up">
      <div class="pdetail__card">
        <h2 id="about-project" class="pdetail__cardtitle">About the project</h2>
        <dl class="pspecs">
          {project.specs.map((spec) => (
            <div class="pspec">
              <dt>
                <span class="pspec__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                       stroke-linecap="round" stroke-linejoin="round">
                    {ICONS[spec.icon].map((d) => <path d={d} />)}
                  </svg>
                </span>
                {spec.label}:
              </dt>
              <dd>
                {spec.icon === 'date'
                  ? <time datetime={project.dateISO}>{spec.value}</time>
                  : spec.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>

    <!-- ---------------------------------------------------------------- -->
    <div class="pdetail__main">
      <figure class="pdetail__hero reveal-image">
        <img
          src={project.hero.src}
          alt={project.hero.alt}
          width="1366"
          height="769"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      {project.body.map((section) => (
        <div class="pdetail__block" data-anim="up">
          <h2 class="pdetail__h2">{section.heading}</h2>
          {section.paragraphs.map((p) => <p>{p}</p>)}
          {section.points && (
            <ul class="pticks">
              {section.points.map((point) => (
                <li>
                  <span class="pticks__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                         stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4 10-10" />
                    </svg>
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}

      {project.gallery.length > 0 && (
        <div class="pdetail__block" data-anim="up">
          <h2 class="pdetail__h2">Project Gallery</h2>
          <ul class="pgallery">
            {project.gallery.map((img) => (
              <li class="pgallery__item">
                <img
                  src={img.src}
                  alt={img.alt}
                  width="1366"
                  height="769"
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        </div>
      )}

      {(prev || next) && (
        <nav class="pnav" aria-label="Project navigation">
          {prev && (
            <a class="pnav__link pnav__link--prev" href={`/portfolio/${prev.slug}/`} rel="prev">
              <span class="pnav__dir">
                <span class="pnav__arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 8H3M7 4 3 8l4 4" />
                  </svg>
                </span>
                Previous project
              </span>
              <span class="pnav__title">{prev.title}</span>
            </a>
          )}
          {next && (
            <a class="pnav__link pnav__link--next" href={`/portfolio/${next.slug}/`} rel="next">
              <span class="pnav__dir">
                Next project
                <span class="pnav__arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 8h11M9 4l4 4-4 4" />
                  </svg>
                </span>
              </span>
              <span class="pnav__title">{next.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </div>
</section>

<style>
  .pdetail__layout {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    align-items: start;
    gap: 1.875rem;
  }

  /* ---- sidebar --------------------------------------------------------- */
  .pdetail__aside { position: sticky; top: calc(var(--header-h) + 1.25rem); }

  .pdetail__card {
    padding: 1.875rem 1.5rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
  }
  .pdetail__cardtitle {
    margin-bottom: 1.25rem;
    font-size: var(--text-h4);
  }

  /* The DL content model only allows dt/dd (and script) inside the grouping
     <div>, so the icon lives in the <dt> and is lifted out of flow to sit
     centred against both lines. */
  .pspec {
    position: relative;
    padding: 1rem 0 1rem calc(2.375rem + 0.875rem);
    border-top: 1px solid var(--color-border);
  }
  .pspec:first-child { padding-top: 0; border-top: 0; }
  .pspec:last-child { padding-bottom: 0; }

  .pspec__icon {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    transform: translateY(-50%);
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
  }
  .pspec__icon svg { width: 1.25rem; height: 1.25rem; }

  .pspec dt {
    font-family: var(--font-display);
    font-size: var(--text-h6);
    font-weight: var(--weight-bold);
    line-height: 1.3;
    color: var(--color-heading);
  }
  .pspec dd {
    margin: 0.125rem 0 0;
    font-size: var(--text-base);
    color: var(--color-text);
  }

  /* ---- main ------------------------------------------------------------ */
  .pdetail__hero {
    margin: 0 0 2.25rem;
    border-radius: var(--radius-lg);
  }
  .pdetail__hero img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .pdetail__block + .pdetail__block { margin-top: 2.25rem; }
  .pdetail__h2 { font-size: var(--text-h3); margin-bottom: 1rem; }
  .pdetail__block p { color: var(--color-text); margin-bottom: 1.25rem; }

  .pticks {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .pticks li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .pticks__mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.125rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: 50%;
  }
  .pticks__mark svg { width: 0.8125rem; height: 0.8125rem; }

  /* ---- gallery --------------------------------------------------------- */
  .pgallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .pgallery__item {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
  }
  .pgallery__item img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .pgallery__item:hover img { transform: scale(1.06); }

  /* ---- prev / next ----------------------------------------------------- */
  .pnav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 3.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-border);
  }
  .pnav__link {
    display: block;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .pnav__link--next { text-align: right; }
  .pnav__link:only-child { grid-column: 1 / -1; }

  .pnav__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .pnav__arrow { display: inline-flex; width: 1rem; height: 1rem; }
  .pnav__arrow svg { width: 100%; height: 100%; }

  .pnav__title {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-h5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-display);
    color: var(--color-heading);
  }
  .pnav__link:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-accent);
  }

  /* ---- responsive ------------------------------------------------------ */
  @media (max-width: 991px) {
    .pdetail__layout { grid-template-columns: minmax(0, 1fr); }
    .pdetail__aside { position: static; }
    .pgallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 575px) {
    .pdetail__card { padding: 1.5rem 1.25rem; }
    .pnav { grid-template-columns: minmax(0, 1fr); }
    .pnav__link--next { text-align: left; }
  }
</style>
