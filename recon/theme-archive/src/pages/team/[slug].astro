---
/** Team member detail — the rebuild of the original /team/team-single page. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import TeamGrid from '../../components/sections/TeamGrid.astro';
import Button from '../../components/ui/Button.astro';
import { team, type TeamMember } from '../../data/team';

export function getStaticPaths() {
  return team.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const others = team.filter((m) => m.slug !== member.slug).slice(0, 4);

const facts = [
  { label: 'Position', value: member.role },
  { label: 'Experience', value: member.experience },
  { label: 'Email', value: member.email, href: `mailto:${member.email}` },
  { label: 'Phone', value: member.phone, href: `tel:${member.phone.replace(/[^+\d]/g, '')}` },
];
---

<Base
  title={`${member.name} — ${member.role} at Solor`}
  description={member.summary}
>
  <PageHero
    title={member.name}
    crumbs={[{ label: 'Team', href: '/team' }, { label: member.name }]}
  />

  <section class="member section">
    <div class="container-site member__grid">
      <aside class="member__aside">
        <div class="reveal-image member__photo">
          <img
            src={member.image}
            alt={`Portrait of ${member.name}`}
            width="520"
            height="600"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <dl class="member__facts" data-anim="up" data-anim-delay="0.1">
          {facts.map((f) => (
            <div class="member__fact">
              <dt>{f.label}</dt>
              <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
            </div>
          ))}
        </dl>

        <ul class="member__socials" data-anim="up" data-anim-delay="0.2">
          {member.socials.map((s) => (
            <li>
              <a href={s.href} aria-label={`${member.name} on ${s.label}`} rel="noopener noreferrer" target="_blank">
                <span aria-hidden="true">
                  {s.icon === 'facebook' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.25-1.5 1.5-1.5H16.6V4.4A20 20 0 0014.4 4.3c-2.2 0-3.7 1.3-3.7 3.9v2.3H8v3h2.7V21z" />
                    </svg>
                  )}
                  {s.icon === 'x' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.2 3.6h2.9l-6.3 7.2 7.4 9.6h-5.8l-4.5-5.9-5.2 5.9H2.8l6.7-7.7L2.4 3.6h5.9l4.1 5.4zm-1 14.9h1.6L7.9 5.2H6.2z" />
                    </svg>
                  )}
                  {s.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M6.2 9.2v11.3H2.8V9.2zM4.5 3.5a2 2 0 110 4 2 2 0 010-4zM21.2 14v6.5h-3.4v-6c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.9 1.4l-.1 1v6.1H10.6s.05-10.2 0-11.3H14v1.7c.5-.8 1.3-1.9 3.2-1.9 2.4 0 4 1.5 4 4.9z" />
                    </svg>
                  )}
                  {s.icon === 'instagram' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>

      <div class="member__body">
        <p class="member__eyebrow" data-anim="up">{member.role}</p>
        <h2 class="member__name" data-anim="up" data-anim-delay="0.05">{member.name}</h2>
        <p class="member__summary" data-anim="up" data-anim-delay="0.1">{member.summary}</p>

        {member.bio.map((p, i) => (
          <p class="member__text" data-anim="up" data-anim-delay={`${0.15 + i * 0.08}`}>{p}</p>
        ))}

        <h3 class="member__subhead" data-anim="up">Areas of Expertise</h3>
        <ul class="member__skills">
          {member.skills.map((skill, i) => (
            <li class="member__skill" data-anim="up" data-anim-delay={`${i * 0.1}`}>
              <span class="member__skill-label">{skill.label}</span>
              {/* The label lives inside the bar's parent — that is where
                  initProgressBars() looks for [data-progress-label]. */}
              <div class="member__track">
                <span class="member__bar" data-progress={`${skill.value}`}></span>
                <span class="member__skill-value" data-progress-label>0%</span>
              </div>
            </li>
          ))}
        </ul>

        <div class="member__cta" data-anim="up" data-anim-delay="0.2">
          <Button href="/contact">Work With {member.name.split(' ')[0]}</Button>
        </div>
      </div>
    </div>
  </section>

  <TeamGrid
    members={others}
    eyebrow="Our Team"
    title="Meet The Rest Of The Team"
    tone="alt"
  />
</Base>

<style>
  .member__grid {
    display: grid;
    gap: 3.75rem;
    align-items: start;
  }

  /* ---------- aside ---------- */
  .member__photo {
    border-radius: var(--radius-lg);
  }
  .member__photo img {
    width: 100%;
    aspect-ratio: 13 / 15;
    object-fit: cover;
  }

  .member__facts {
    margin: 2rem 0 0;
    padding: 1.75rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
  }
  .member__fact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--color-border);
  }
  .member__fact:first-child { padding-top: 0; }
  .member__fact:last-child { padding-bottom: 0; border-bottom: 0; }

  .member__fact dt {
    font-family: var(--font-display);
    font-size: var(--text-h6);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .member__fact dd {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  .member__fact dd a:hover { color: var(--color-heading); }

  .member__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }
  .member__socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-bg-alt);
    color: var(--color-heading);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .member__socials a:hover,
  .member__socials a:focus-visible {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .member__socials svg { width: 1.125rem; height: 1.125rem; }

  /* ---------- body ---------- */
  .member__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-heading);
  }
  .member__eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: var(--color-accent);
  }

  .member__name { font-size: var(--text-h2); margin-bottom: 0.75rem; }

  .member__summary {
    font-size: var(--text-lead);
    color: var(--color-heading);
    font-weight: var(--weight-medium);
    margin-bottom: 1.5rem;
  }
  .member__text { color: var(--color-text); margin-bottom: 1.25rem; }

  .member__subhead {
    font-size: var(--text-h4);
    margin: 2.5rem 0 1.25rem;
  }

  .member__skills { display: grid; gap: 1.25rem; }

  .member__skill-label {
    display: block;
    margin-bottom: 0.625rem;
    padding-right: 3rem;
    font-family: var(--font-display);
    font-size: var(--text-h6);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .member__skill-value {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .member__track {
    position: relative;
    height: 0.5rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-pill);
  }
  .member__bar {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-accent);
    border-radius: var(--radius-pill);
  }

  .member__cta { margin-top: 2.5rem; }

  @media (min-width: 992px) {
    .member__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  }
</style>
