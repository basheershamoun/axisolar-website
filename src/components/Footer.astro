---
/** Site footer: scrolling marquee, contact strip, link columns, legal bar. */
import { site, productLines } from '../data/site';

const marquee = [
  'N-Type Bifacial Modules',
  'Hybrid Inverters 3–20 kW',
  'AC & DC EV Charging',
  'Datasheets On Request',
  'Built For Installers',
];
const contact = [
  { label: 'Sales & Support', value: site.email, href: `mailto:${site.email}`, icon: 'mail' },
];
const columns = [
  {
    title: 'Products',
    links: productLines.map((l) => ({ label: l.label, href: l.href })),
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Downloads', href: '/downloads' },
      { label: 'Verify Product', href: '/verify' },
      { label: 'Contact Us', href: '/contact' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="ftr">
  <!-- Marquee. Duplicated once and shifted by exactly -50% so the loop is
       seamless; aria-hidden on the copy so it isn't announced twice. -->
  <div class="ftr__marquee" role="marquee" aria-label="AXI SOLAR highlights">
    <div class="ftr__marquee-track">
      {[0, 1].map((copy) => (
        <ul class="ftr__marquee-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {marquee.map((item) => (
            <li>
              <span class="ftr__marquee-dot" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <div class="ftr__body">
    <div class="container-site">
      <ul class="ftr__contact">
        {contact.map((c) => (
          <li class="ftr__contact-item">
            <span class="ftr__contact-icon" aria-hidden="true">
              {c.icon === 'mail' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="M3 7l9 6 9-6" />
                </svg>
              )}
            </span>
            <div>
              <p class="ftr__contact-label">{c.label}</p>
              {c.href ? <a href={c.href} class="ftr__contact-value">{c.value}</a>
                      : <p class="ftr__contact-value">{c.value}</p>}
            </div>
          </li>
        ))}
      </ul>

      <div class="ftr__grid">
        <div class="ftr__brand">
          <a href="/" aria-label={`${site.name} — home`}>
            <img src="/images/axi-logo-light.webp" alt={site.name} width="106" height="48" />
          </a>
          <p>
            {site.tagline}
          </p>
        </div>

        {columns.map((col) => (
          <nav class="ftr__col" aria-label={col.title}>
            <h3 class="ftr__col-title">{col.title}</h3>
            <ul>
              {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>

      <div class="ftr__legal">
        <p>Copyright © {year} {site.name}. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--color-forest); color: var(--color-on-dark); }

  /* ---- Marquee ---------------------------------------------------------
     Animates transform only, so it runs on the compositor. */
  .ftr__marquee {
    padding-block: 1.25rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    overflow: hidden;
  }
  .ftr__marquee-track {
    display: flex;
    width: max-content;
    animation: ftr-scroll 30s linear infinite;
  }
  .ftr__marquee:hover .ftr__marquee-track { animation-play-state: paused; }
  .ftr__marquee-list { display: flex; align-items: center; }
  .ftr__marquee-list li {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding-inline: 1rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .ftr__marquee-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-on-accent);
  }
  @keyframes ftr-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ftr__marquee-track { animation: none; }
    .ftr__marquee { overflow-x: auto; }
  }

  /* ---- Body ------------------------------------------------------------ */
  .ftr__body { padding-top: 4.375rem; }

  .ftr__contact {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 3.125rem;
    border-bottom: 1px solid var(--color-border-dark);
  }
  .ftr__contact-item { display: flex; align-items: center; gap: 1rem; }
  .ftr__contact-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-white-12);
    color: var(--color-accent);
  }
  .ftr__contact-icon svg { width: 1.375rem; height: 1.375rem; }
  .ftr__contact-label { margin: 0; font-size: var(--text-sm); color: var(--color-on-dark-muted); }
  .ftr__contact-value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h5);
    font-weight: var(--weight-semibold);
    color: var(--color-white);
  }
  a.ftr__contact-value:hover { color: var(--color-accent-on-dark); }

  .ftr__grid {
    display: grid;
    grid-template-columns: 2fr repeat(2, 1fr);
    gap: 2.5rem;
    padding-block: 3.75rem;
  }
  .ftr__brand p { margin: 1.25rem 0; color: var(--color-on-dark-muted); max-width: 22rem; }

  .ftr__col-title {
    margin-bottom: 1.25rem;
    font-size: var(--text-h5);
    color: var(--color-white);
  }
  .ftr__col li + li { margin-top: 0.625rem; }
  .ftr__col a { color: var(--color-on-dark-muted); }
  .ftr__col a:hover { color: var(--color-accent); }

  .ftr__legal {
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-border-dark);
    text-align: center;
  }
  .ftr__legal p { margin: 0; font-size: var(--text-sm); color: var(--color-on-dark-muted); }

  @media (max-width: 991px) {
    .ftr__contact { grid-template-columns: 1fr; }
    .ftr__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 575px) {
    .ftr__grid { grid-template-columns: 1fr; }
  }
</style>
