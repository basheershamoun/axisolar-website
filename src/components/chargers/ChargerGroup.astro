---
/** One charger family: heading, product cards and a compact comparison table. */
import type { Product } from '../../data/products/types';
import { chargerCompare } from '../../data/products/chargers';
import SectionHeading from '../ui/SectionHeading.astro';
import ProductCard from '../products/ProductCard.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  text: string;
  products: Product[];
  alt?: boolean;
}
const { id, eyebrow, title, text, products, alt = false } = Astro.props;

const cols = [
  { key: 'power', label: 'Power' },
  { key: 'connectors', label: 'Connectors / guns' },
  { key: 'input', label: 'Phases / input' },
  { key: 'ip', label: 'IP rating' },
  { key: 'ocpp', label: 'OCPP' },
  { key: 'mounting', label: 'Mounting' },
] as const;
---

<section class:list={['section', 'cgroup', { 'is-alt': alt }]} id={id} aria-label={title}>
  <div class="container-site">
    <SectionHeading eyebrow={eyebrow} title={title} text={text} class="cgroup__head" />

    <div class="cgroup__grid">
      {products.map((p, i) => (
        <ProductCard product={p} href={`/ev-chargers/${p.slug}`} delay={(i % 3) * 0.08} />
      ))}
    </div>

    <h3 class="cgroup__compare-title" data-anim="up">Compare {title}</h3>
    <div class="cgroup__scroll" data-anim="up" tabindex="0" role="region" aria-label={`${title} comparison`}>
      <table class="cgroup__table">
        <thead>
          <tr>
            <th scope="col">Model</th>
            {cols.map((c) => <th scope="col">{c.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {products.map((p) => (
            <tr>
              <th scope="row"><a href={`/ev-chargers/${p.slug}`}>{p.name}</a></th>
              {cols.map((c) => <td>{chargerCompare[p.slug]?.[c.key] ?? '—'}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="cgroup__note">— not stated on the datasheet. See each model for full specifications.</p>
  </div>
</section>

<style>
  .cgroup.is-alt { background: var(--color-bg-alt); }
  .cgroup :global(.cgroup__head) { margin-bottom: 3rem; }

  .cgroup__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .cgroup__compare-title { margin: 4rem 0 1.25rem; font-size: var(--text-h4); }
  .cgroup__scroll {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .cgroup__scroll:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .cgroup__table {
    width: 100%;
    min-width: 52rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .cgroup__table th,
  .cgroup__table td {
    padding: 0.75rem 1rem;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
  }
  .cgroup__table thead th {
    background: var(--color-forest);
    color: var(--color-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }
  .cgroup__table tbody th {
    color: var(--color-heading);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .cgroup__table tbody th a:hover { color: var(--color-accent-ink); }
  .cgroup__table tbody tr:last-child > * { border-bottom: 0; }
  .cgroup__note { margin-top: 0.75rem; font-size: var(--text-sm); }

  @media (max-width: 991px) {
    .cgroup__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 575px) {
    .cgroup__grid { grid-template-columns: 1fr; }
  }
</style>
