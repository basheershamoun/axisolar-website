---
/** Product card for category grids: image, name, tagline, headline figures. */
import type { Product } from '../../data/products/types';

interface Props {
  product: Product;
  href: string;
  delay?: number;
}
const { product, href, delay = 0 } = Astro.props;
---

<article class="pcard" data-anim="up" data-anim-delay={delay}>
  <a href={href} class="pcard__link">
    <div class="pcard__media">
      <img src={product.image} alt={product.imageAlt} loading="lazy" decoding="async" />
      {product.status === 'discontinued' && <span class="pcard__badge">Discontinued</span>}
    </div>
    <div class="pcard__body">
      {product.family && <p class="pcard__family">{product.family}</p>}
      <h3 class="pcard__name">{product.name}</h3>
      <p class="pcard__tagline">{product.tagline}</p>
      <dl class="pcard__stats">
        {product.highlights.slice(0, 3).map((h) => (
          <div><dt>{h.label}</dt><dd>{h.value}</dd></div>
        ))}
      </dl>
      <span class="pcard__more">View specifications <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .pcard { height: 100%; }
  .pcard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    overflow: hidden;
    transition: box-shadow var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .pcard__link:hover { box-shadow: var(--shadow-lift); transform: translateY(-4px); }
  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-alt);
    overflow: hidden;
  }
  /* Absolutely fill the aspect-ratio box: a % max-height never resolves in an
     auto grid row, so the box itself is the size constraint. Padding sits on
     the img so object-fit: contain fits the cut-out inside it, uncropped. */
  .pcard__media img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
    padding: 1.5rem;
    box-sizing: border-box;
    object-fit: contain;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .pcard__link:hover .pcard__media img { transform: scale(1.04); }
  .pcard__badge {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-start: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-forest);
    color: var(--color-on-dark);
    font-size: var(--text-sm);
    z-index: 1;
  }
  .pcard__body { display: flex; flex-direction: column; flex: 1; padding: 1.5rem; }
  .pcard__family {
    margin: 0 0 0.25rem;
    color: var(--color-accent-ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pcard__name { margin-bottom: 0.5rem; font-size: var(--text-h4); }
  .pcard__tagline { margin-bottom: 1.25rem; }
  .pcard__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    padding-block: 1rem;
    border-block: 1px solid var(--color-border);
  }
  .pcard__stats dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .pcard__stats dd { margin: 0; color: var(--color-heading); font-family: var(--font-display); font-size: var(--text-h6); font-weight: var(--weight-bold); }
  .pcard__more { margin-top: auto; color: var(--color-accent-ink); font-weight: var(--weight-medium); }
</style>
