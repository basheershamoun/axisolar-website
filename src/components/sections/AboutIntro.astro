---
/**
 * About page opener — stacked image collage beside heading, copy and a
 * two-column checklist.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  paragraphs?: string[];
  points?: string[];
  image?: string;
  imageAlt?: string;
  inset?: string;
  insetAlt?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'About AXI SOLAR',
  title = 'Technology and Standards You Can Build On',
  paragraphs = [
    'AXI SOLAR is a solar energy manufacturer known for current technology and exacting standards. Every product we ship is built to the highest quality we can deliver.',
    'Our motivation is a brighter, more environmentally friendly future. We believe solar energy can transform how the world is powered, and we want our products to make a real difference to the planet and to the people who rely on them.',
    'We supply residential, commercial and industrial projects, helping businesses and households cut their carbon footprint and move to clean, sustainable energy.',
  ],
  points = [
    'N-type bifacial solar panels',
    '48 V hybrid inverters',
    'AC & DC EV chargers',
    'Datasheets for every product',
  ],
  image = '/images/axi/panel-field.webp',
  imageAlt = 'Aerial view of ground-mounted solar panel rows',
  inset = '/images/axi/installer-roof.webp',
  insetAlt = 'Installer carrying a solar module across a tiled roof',
  ctaLabel = 'Contact sales',
  ctaHref = '/contact',
} = Astro.props;
---

<section class="about-intro section">
  <div class="container-site about-intro__grid">
    <div class="about-intro__media">
      <span class="about-intro__dots" aria-hidden="true"></span>

      <div class="reveal-image about-intro__frame">
        <img
          src={image}
          alt={imageAlt}
          width="1920"
          height="1079"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="reveal-image about-intro__frame about-intro__frame--inset">
        <img
          src={inset}
          alt={insetAlt}
          width="900"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="about-intro__body">
      <SectionHeading eyebrow={eyebrow} title={title} />

      {paragraphs.map((p, i) => (
        <p class="about-intro__text" data-anim="up" data-anim-delay={`${0.1 + i * 0.1}`}>{p}</p>
      ))}

      <ul class="about-intro__points" data-anim="up" data-anim-delay="0.3">
        {points.map((point) => (
          <li>
            <span class="about-intro__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {point}
          </li>
        ))}
      </ul>

      {ctaLabel && (
        <div class="about-intro__cta" data-anim="up" data-anim-delay="0.4">
          <Button href={ctaHref}>{ctaLabel}</Button>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about-intro__grid {
    display: grid;
    gap: 3.75rem;
    align-items: center;
  }

  /* ---------- media ---------- */
  .about-intro__media {
    position: relative;
    padding-block-end: 4.5rem;
  }

  .about-intro__frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .about-intro__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-intro__frame--inset {
    width: 58%;
    margin-block-start: -4.5rem;
    margin-inline-start: auto;
    border: 0.625rem solid var(--color-white);
    box-shadow: var(--shadow-card);
  }

  /* Dot grid echoing the original's decorative pattern. */
  .about-intro__dots {
    position: absolute;
    inset-block-start: -1.25rem;
    inset-inline-end: -1.25rem;
    width: 9rem;
    height: 9rem;
    background-image: radial-gradient(var(--color-accent) 1.5px, transparent 1.6px);
    background-size: 1rem 1rem;
    opacity: 0.55;
  }

  /* The pattern is deliberately offset past the image edge, which overhangs the
     viewport on small screens. Pull it back inside below 36rem — it is purely
     decorative, so losing the overhang costs nothing. */
  @media (max-width: 36rem) {
    .about-intro__dots {
      inset-inline-end: 0;
      inset-block-start: -0.75rem;
      width: 6rem;
      height: 6rem;
    }
  }

  /* ---------- body ---------- */
  .about-intro__text {
    color: var(--color-text);
    margin-block-end: 1.25rem;
  }

  .about-intro__points {
    display: grid;
    gap: 0.875rem 2rem;
    margin-block: 1.75rem 0;
  }
  .about-intro__points li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-h6);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }

  .about-intro__tick {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .about-intro__tick svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .about-intro__cta { margin-block-start: 2.25rem; }

  @media (min-width: 576px) {
    .about-intro__points { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 992px) {
    .about-intro__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about-intro__media { padding-block-end: 0; }
    .about-intro__frame--inset {
      position: absolute;
      inset-inline-end: -2.5rem;
      inset-block-end: -2.5rem;
      width: 55%;
      margin: 0;
    }
  }
</style>
