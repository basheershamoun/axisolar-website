---
/** Core values — white tiles on the mist band. */
import SectionHeading from '../ui/SectionHeading.astro';

type IconName = 'quality' | 'innovation' | 'leaf';

interface Value {
  icon: IconName;
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  values?: Value[];
}

const {
  eyebrow = 'Our core values',
  title = 'What Guides Every Decision',
  values = [
    {
      icon: 'quality',
      title: 'Quality',
      text: 'Products that exceed our customers’ expectations, with strict quality control so every module is reliable and durable.',
    },
    {
      icon: 'innovation',
      title: 'Innovation',
      text: 'We work to stay at the front of solar technology, developing solutions that get the most out of every hour of sun.',
    },
    {
      icon: 'leaf',
      title: 'Sustainability',
      text: 'Environmental care is part of everything we do, from sustainable manufacturing practices to promoting clean energy.',
    },
  ],
} = Astro.props;
---

<section class="values section">
  <div class="container-site">
    <SectionHeading eyebrow={eyebrow} title={title} align="center" class="values__head" />

    <ul class="values__grid">
      {values.map((v, i) => (
        <li class="values__card" data-anim="up" data-anim-delay={`${i * 0.12}`}>
          <span class="values__icon" aria-hidden="true">
            {v.icon === 'innovation' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13z" stroke-linejoin="round" />
              </svg>
            )}
            {v.icon === 'quality' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="12" cy="9" r="5.5" />
                <path d="M8 13.5L6.5 21.5 12 19l5.5 2.5-1.5-8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {v.icon === 'leaf' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M5 19c3-4 6-7 10-9" stroke-linecap="round" />
              </svg>
            )}
          </span>

          <h3 class="values__title">{v.title}</h3>
          <p class="values__text">{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .values {
    background: var(--color-bg-alt);
  }

  .values :global(.values__head) { margin-block-end: 3.25rem; }

  .values__grid {
    display: grid;
    gap: 1.875rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .values__card {
    padding: 2.25rem 1.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .values__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card);
  }

  .values__icon {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    margin-block-end: 1.5rem;
    border-radius: var(--radius-md);
    background: var(--color-parchment);
    color: var(--color-heading);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .values__icon svg { width: 1.875rem; height: 1.875rem; }
  .values__card:hover .values__icon { background: var(--color-accent); }

  .values__title {
    font-size: var(--text-h5);
    margin-block-end: 0.625rem;
  }
  .values__text {
    color: var(--color-text);
    font-size: var(--text-base);
  }

  @media (max-width: 575px) {
    .values__grid { grid-template-columns: 1fr; }
  }
</style>
