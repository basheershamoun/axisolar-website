---
/**
 * Contact form.
 *
 * A real <form> with a real <label> per control — nothing relies on the
 * placeholder for its name. Validation is progressive: the markup is valid and
 * submittable on its own, and the script adds inline messages, aria-invalid,
 * focus handling and a polite live-region summary on top.
 *
 * There is no backend in this static build, so `action` defaults to "#" and the
 * submit is intercepted. See the WIRE A REAL ENDPOINT note in the script below.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { nav } from '../../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  /** Where the form posts. Swap for a Formspree URL or an Astro endpoint. */
  action?: string;
  /** Prefix for every id in the form — change it if two forms share a page. */
  formId?: string;
}

const {
  eyebrow = 'Contact Now',
  title = 'Get In Touch With Us',
  action = '#',
  formId = 'contact',
} = Astro.props;

/** The six service names, sourced from the same nav data the header uses. */
const services = (nav.find((item) => item.label === 'Services')?.children ?? []).map(
  (child) => child.label,
);
---

<section class="section cform-sec" aria-label="Contact form">
  <div class="container-site">
    <SectionHeading eyebrow={eyebrow} title={title} align="center" class="cform-sec__head" />

    {/* Polite summary: announced after a failed or successful submit. It sits
        outside the form so it survives the form being hidden on success. */}
    <p class="cform__status" id={`${formId}-status`} role="status" aria-live="polite"></p>

    <form
      class="cform"
      id={formId}
      action={action}
      method="post"
      novalidate
      data-contact-form
      data-anim="up"
    >
      <div class="cform__grid">
        <div class="field">
          <label for={`${formId}-name`}>
            Your name <span class="field__req" aria-hidden="true">*</span>
          </label>
          <input
            id={`${formId}-name`}
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Jane Doe"
            required
            aria-required="true"
            aria-describedby={`${formId}-name-error`}
            data-msg-required="Please enter your name."
          />
          <p class="field__error" id={`${formId}-name-error`}></p>
        </div>

        <div class="field">
          <label for={`${formId}-email`}>
            Email address <span class="field__req" aria-hidden="true">*</span>
          </label>
          <input
            id={`${formId}-email`}
            name="email"
            type="email"
            autocomplete="email"
            placeholder="jane@example.com"
            required
            aria-required="true"
            aria-describedby={`${formId}-email-error`}
            data-validate="email"
            data-msg-required="Please enter your email address."
            data-msg-invalid="Please enter a valid email address, like jane@example.com."
          />
          <p class="field__error" id={`${formId}-email-error`}></p>
        </div>

        <div class="field">
          <label for={`${formId}-phone`}>Phone number <span class="field__hint">(optional)</span></label>
          <input
            id={`${formId}-phone`}
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="+01 248 248 2481"
            aria-describedby={`${formId}-phone-error`}
            data-validate="tel"
            data-msg-invalid="Please enter a phone number using digits, spaces, + ( ) or -."
          />
          <p class="field__error" id={`${formId}-phone-error`}></p>
        </div>

        <div class="field">
          <label for={`${formId}-service`}>
            Service you need <span class="field__req" aria-hidden="true">*</span>
          </label>
          <select
            id={`${formId}-service`}
            name="service"
            required
            aria-required="true"
            aria-describedby={`${formId}-service-error`}
            data-msg-required="Please choose the service you need."
          >
            <option value="">Choose a service…</option>
            {services.map((service) => <option value={service}>{service}</option>)}
            <option value="Something else">Something else</option>
          </select>
          <p class="field__error" id={`${formId}-service-error`}></p>
        </div>

        <div class="field field--full">
          <label for={`${formId}-message`}>
            Your message <span class="field__req" aria-hidden="true">*</span>
          </label>
          <textarea
            id={`${formId}-message`}
            name="message"
            rows="6"
            placeholder="Tell us about your roof, your current bill, and what you would like to achieve."
            required
            aria-required="true"
            aria-describedby={`${formId}-message-error`}
            data-msg-required="Please tell us a little about your project."
          ></textarea>
          <p class="field__error" id={`${formId}-message-error`}></p>
        </div>
      </div>

      {/* Honeypot: off-screen for sighted users, aria-hidden and untabbable for
          assistive tech. Bots fill it in, people never see it. */}
      <div class="cform__hp" aria-hidden="true">
        <label for={`${formId}-website`}>Leave this field empty</label>
        <input
          id={`${formId}-website`}
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          data-honeypot
        />
      </div>

      <div class="cform__actions">
        <button type="submit" class="cform__submit">
          <span>Submit Now</span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </form>

    <div class="cform__success" id={`${formId}-success`} hidden>
      <h3 tabindex="-1">Thanks — your message is on its way.</h3>
      <p>
        A member of the Solor team will get back to you within one working day. If it is
        urgent, call us and we will pick up.
      </p>
    </div>
  </div>
</section>

<style>
  .cform-sec__head {
    margin-bottom: 3rem;
  }

  .cform {
    max-width: 51.25rem;
    margin-inline: auto;
  }

  .cform__status:empty {
    display: none;
  }
  .cform__status {
    max-width: 51.25rem;
    margin-inline: auto;
    margin-bottom: 1.5rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-parchment);
    border: 1px solid var(--color-border);
    color: var(--color-heading);
    font-weight: var(--weight-medium);
  }

  .cform__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .field--full {
    grid-column: 1 / -1;
  }

  .field label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .field__req {
    color: var(--color-accent);
  }
  .field__hint {
    font-weight: var(--weight-body);
    color: var(--color-text);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.9375rem 1.25rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-heading);
    background: var(--color-bg-alt);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }
  .field select {
    appearance: none;
    /* Chevron drawn with tokens only — no hardcoded colour in the data URI. */
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 1.375rem) calc(50% + 0.1rem),
      calc(100% - 1rem) calc(50% + 0.1rem);
    background-size:
      0.375rem 0.375rem,
      0.375rem 0.375rem;
    background-repeat: no-repeat;
    padding-right: 3rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-text);
    opacity: 1;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    background: var(--color-parchment);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    background: var(--color-white);
    border-color: var(--color-accent);
  }

  .field [aria-invalid='true'] {
    border-color: var(--color-heading);
    background: var(--color-white);
  }

  .field__error:empty {
    display: none;
  }
  .field__error {
    display: flex;
    gap: 0.375rem;
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .field__error::before {
    content: '!';
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.75rem;
    line-height: 1;
  }

  /* Honeypot — visually gone, out of the a11y tree, still in the POST body. */
  .cform__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .cform__actions {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .cform__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 2.5rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-pill);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .cform__submit svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cform__submit:hover,
  .cform__submit:focus-visible {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .cform__submit:hover svg {
    transform: translateX(3px);
  }

  .cform__success {
    max-width: 51.25rem;
    margin-inline: auto;
    padding: 2.5rem;
    text-align: center;
    background: var(--color-parchment);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .cform__success h3 {
    color: var(--color-heading);
  }
  .cform__success p {
    color: var(--color-text);
  }

  @media (max-width: 767px) {
    .cform__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const TEL_RE = /^[+()\d\s-]{6,}$/;

  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  function errorNodeFor(control: Control): HTMLElement | null {
    const id = control.getAttribute('aria-describedby');
    return id ? document.getElementById(id) : null;
  }

  function validate(control: Control): string | null {
    const value = control.value.trim();

    if (control.hasAttribute('required') && !value) {
      return control.dataset.msgRequired || 'This field is required.';
    }
    if (!value) return null;

    const kind = control.dataset.validate;
    if (kind === 'email' && !EMAIL_RE.test(value)) {
      return control.dataset.msgInvalid || 'Please enter a valid email address.';
    }
    if (kind === 'tel' && !TEL_RE.test(value)) {
      return control.dataset.msgInvalid || 'Please enter a valid phone number.';
    }
    return null;
  }

  function setError(control: Control, message: string | null) {
    const node = errorNodeFor(control);
    if (message) {
      control.setAttribute('aria-invalid', 'true');
      if (node) node.textContent = message;
    } else {
      control.removeAttribute('aria-invalid');
      if (node) node.textContent = '';
    }
  }

  function enhanceForm(form: HTMLFormElement) {
    const status = document.getElementById(`${form.id}-status`);
    const success = document.getElementById(`${form.id}-success`);
    const controls = Array.from(
      form.querySelectorAll<Control>('input[name], select[name], textarea[name]'),
    ).filter((c) => !('honeypot' in c.dataset));

    // Re-validate a field once it has been flagged, so the error clears as
    // soon as the person fixes it rather than only on the next submit.
    controls.forEach((control) => {
      control.addEventListener('blur', () => {
        if (control.getAttribute('aria-invalid') === 'true' || control.value.trim()) {
          setError(control, validate(control));
        }
      });
      control.addEventListener('input', () => {
        if (control.getAttribute('aria-invalid') === 'true') {
          setError(control, validate(control));
        }
      });
    });

    form.addEventListener('submit', (event) => {
      // ----------------------------------------------------------------
      // WIRE A REAL ENDPOINT HERE
      // This build is static, so the submit is stopped in the browser and a
      // success state is shown. To actually deliver the message either:
      //   1. pass action="https://formspree.io/f/<your-id>" to <ContactForm />
      //      and drop the preventDefault() below so the browser posts it, or
      //   2. keep preventDefault() and POST it yourself to an Astro server
      //      endpoint (src/pages/api/contact.ts exporting `POST`):
      //        const res = await fetch(form.action, {
      //          method: 'POST',
      //          body: new FormData(form),
      //          headers: { Accept: 'application/json' },
      //        });
      //      then branch on res.ok for the success / failure message.
      // ----------------------------------------------------------------
      event.preventDefault();

      const honeypot = form.querySelector<HTMLInputElement>('[data-honeypot]');
      if (honeypot && honeypot.value) return; // silently drop bot submissions

      const invalid: Control[] = [];
      controls.forEach((control) => {
        const message = validate(control);
        setError(control, message);
        if (message) invalid.push(control);
      });

      if (invalid.length) {
        if (status) {
          status.textContent =
            invalid.length === 1
              ? 'There is 1 problem with the form. Please check the highlighted field.'
              : `There are ${invalid.length} problems with the form. Please check the highlighted fields.`;
        }
        invalid[0].focus();
        return;
      }

      if (status) status.textContent = 'Thanks — your message has been sent.';
      form.hidden = true;
      if (success) {
        success.hidden = false;
        success.querySelector<HTMLElement>('h3')?.focus();
      }
      form.reset();
    });
  }

  function initContactForms() {
    document
      .querySelectorAll<HTMLFormElement>('form[data-contact-form]')
      .forEach(enhanceForm);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForms, { once: true });
  } else {
    initContactForms();
  }
</script>
