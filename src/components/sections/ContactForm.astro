---
/**
 * Sales enquiry form.
 *
 * A real <form> with a real <label> per control. Validation is progressive:
 * the markup posts on its own, and the script adds inline messages,
 * aria-invalid, focus handling and a polite live-region summary on top.
 *
 * `?product=AXI%20LUMEN` (linked from product pages) prefills the product
 * interest and the message — see the inline script after the form.
 */
import { site } from '../../data/site';
import { allProducts } from '../../data/products';
import { lineLabel } from './lines';

interface Props {
  /**
   * Where the form posts.
   * TODO: replace with the real endpoint once chosen (Formspree form id, or an
   * Astro server endpoint). Until then submissions fail and the visitor is
   * pointed to the email address instead.
   */
  action?: string;
  /** Prefix for every id in the form — change it if two forms share a page. */
  formId?: string;
}

const { action = 'https://formspree.io/f/REPLACE_ME', formId = 'contact' } = Astro.props;

const roles = ['Installer', 'Distributor', 'Engineer', 'Other'];
const interests = ['Solar Panels', 'Hybrid Inverters', 'EV Chargers', 'Other'];

/** Product name -> interest option, for the ?product= prefill. */
const productInterest = Object.fromEntries(allProducts.map((p) => [p.name, lineLabel(p.line)]));
---

<div class="cform-wrap">
  {/* Polite summary: announced after a failed or successful submit. It sits
      outside the form so it survives the form being hidden on success. */}
  <p class="cform__status" id={`${formId}-status`} role="status" aria-live="polite"></p>

  <form
    class="cform"
    id={formId}
    action={action}
    method="post"
    novalidate
    data-contact-form
    data-email={site.email}
    data-product-interest={JSON.stringify(productInterest)}
  >
    <div class="cform__grid">
      <div class="field">
        <label for={`${formId}-name`}>
          Your name <span class="field__req" aria-hidden="true">*</span>
        </label>
        <input
          id={`${formId}-name`}
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-required="true"
          aria-describedby={`${formId}-name-error`}
          data-msg-required="Please enter your name."
        />
        <p class="field__error" id={`${formId}-name-error`}></p>
      </div>

      <div class="field">
        <label for={`${formId}-company`}>Company <span class="field__hint">(optional)</span></label>
        <input
          id={`${formId}-company`}
          name="company"
          type="text"
          autocomplete="organization"
          aria-describedby={`${formId}-company-error`}
        />
        <p class="field__error" id={`${formId}-company-error`}></p>
      </div>

      <div class="field">
        <label for={`${formId}-email`}>
          Work email <span class="field__req" aria-hidden="true">*</span>
        </label>
        <input
          id={`${formId}-email`}
          name="email"
          type="email"
          autocomplete="email"
          placeholder="name@company.com"
          required
          aria-required="true"
          aria-describedby={`${formId}-email-error`}
          data-validate="email"
          data-msg-required="Please enter your email address."
          data-msg-invalid="Please enter a valid email address, like name@company.com."
        />
        <p class="field__error" id={`${formId}-email-error`}></p>
      </div>

      <div class="field">
        <label for={`${formId}-country`}>Country <span class="field__hint">(optional)</span></label>
        <input
          id={`${formId}-country`}
          name="country"
          type="text"
          autocomplete="country-name"
          aria-describedby={`${formId}-country-error`}
        />
        <p class="field__error" id={`${formId}-country-error`}></p>
      </div>

      <div class="field">
        <label for={`${formId}-role`}>
          Your role <span class="field__req" aria-hidden="true">*</span>
        </label>
        <select
          id={`${formId}-role`}
          name="role"
          required
          aria-required="true"
          aria-describedby={`${formId}-role-error`}
          data-msg-required="Please choose your role."
        >
          <option value="">Choose a role…</option>
          {roles.map((r) => <option value={r}>{r}</option>)}
        </select>
        <p class="field__error" id={`${formId}-role-error`}></p>
      </div>

      <div class="field">
        <label for={`${formId}-interest`}>
          Product interest <span class="field__req" aria-hidden="true">*</span>
        </label>
        <select
          id={`${formId}-interest`}
          name="product_interest"
          required
          aria-required="true"
          aria-describedby={`${formId}-interest-error`}
          data-msg-required="Please choose the product line you are interested in."
        >
          <option value="">Choose a product line…</option>
          {interests.map((i) => <option value={i}>{i}</option>)}
        </select>
        <p class="field__error" id={`${formId}-interest-error`}></p>
      </div>

      <div class="field field--full">
        <label for={`${formId}-message`}>
          Your message <span class="field__req" aria-hidden="true">*</span>
        </label>
        <textarea
          id={`${formId}-message`}
          name="message"
          rows="6"
          placeholder="Project size, models and quantities, or the technical question you need answered."
          required
          aria-required="true"
          aria-describedby={`${formId}-message-error`}
          data-msg-required="Please tell us a little about your enquiry."
        ></textarea>
        <p class="field__error" id={`${formId}-message-error`}></p>
      </div>
    </div>

    {/* Honeypot: off-screen for sighted users, aria-hidden and untabbable for
        assistive tech. Bots fill it in, people never see it. */}
    <div class="cform__hp" aria-hidden="true">
      <label for={`${formId}-website`}>Leave this field empty</label>
      <input id={`${formId}-website`} name="website" type="text" tabindex="-1" autocomplete="off" data-honeypot />
    </div>

    <div class="cform__actions">
      <button type="submit" class="cform__submit">
        <span>Send enquiry</span>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </form>

  {/* Prefill from ?product= — inline so it runs before first paint. */}
  <script is:inline define:vars={{ formId }}>
    (function () {
      var product = new URLSearchParams(location.search).get('product');
      var form = document.getElementById(formId);
      if (!product || !form) return;
      product = product.trim().slice(0, 80);
      var map = {};
      try { map = JSON.parse(form.dataset.productInterest || '{}'); } catch (e) {}
      var interest = document.getElementById(formId + '-interest');
      if (interest && map[product]) interest.value = map[product];
      var message = document.getElementById(formId + '-message');
      if (message && !message.value) {
        message.value = 'I would like more information about the ' + product + '.';
      }
    })();
  </script>

  <div class="cform__success" id={`${formId}-success`} hidden>
    <h3 tabindex="-1">Thanks, your enquiry is on its way.</h3>
    <p>Our sales team will reply by email. You can also reach us any time at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </div>
</div>

<style>
  .cform-wrap { min-width: 0; }

  .cform__status:empty {
    display: none;
  }
  .cform__status {
    margin-block-end: 1.5rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-parchment);
    border: 1px solid var(--color-border);
    color: var(--color-heading);
    font-weight: var(--weight-medium);
  }

  .cform__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .field--full {
    grid-column: 1 / -1;
  }

  .field label {
    display: block;
    margin-block-end: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .field__req {
    /* The only visual required-field marker. Lime on white is 1.50:1. */
    color: var(--color-accent-ink);
  }
  .field__hint {
    font-weight: var(--weight-body);
    color: var(--color-text);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.9375rem 1.25rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-heading);
    background: var(--color-bg-alt);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }
  .field select {
    appearance: none;
    /* Chevron drawn with tokens only — no hardcoded colour in the data URI. */
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      right 1.375rem center,
      right 1rem center;
    background-size:
      0.375rem 0.375rem,
      0.375rem 0.375rem;
    background-repeat: no-repeat;
    padding-inline-end: 3rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-text);
    opacity: 1;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    background: var(--color-parchment);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    background: var(--color-white);
    border-color: var(--color-accent);
  }

  .field [aria-invalid='true'] {
    border-color: var(--color-heading);
    background: var(--color-white);
  }

  .field__error:empty {
    display: none;
  }
  .field__error {
    display: flex;
    gap: 0.375rem;
    margin: 0;
    margin-block-start: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .field__error::before {
    content: '!';
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.75rem;
    line-height: 1;
  }

  /* Honeypot — visually gone, out of the a11y tree, still in the POST body. */
  .cform__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .cform__actions {
    display: flex;
    justify-content: flex-start;
    margin-block-start: 2rem;
  }
  .cform__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 2.5rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-pill);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .cform__submit svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cform__submit:hover,
  .cform__submit:focus-visible {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .cform__submit:hover svg {
    transform: translateX(3px);
  }
  .cform__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .cform__success {
    padding: 2.5rem;
    text-align: center;
    background: var(--color-parchment);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .cform__success h3 {
    color: var(--color-heading);
  }
  .cform__success p {
    color: var(--color-text);
  }
  .cform__success a {
    color: var(--color-accent-ink);
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .cform__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  function errorNodeFor(control: Control): HTMLElement | null {
    const id = control.getAttribute('aria-describedby');
    return id ? document.getElementById(id) : null;
  }

  function validate(control: Control): string | null {
    const value = control.value.trim();

    if (control.hasAttribute('required') && !value) {
      return control.dataset.msgRequired || 'This field is required.';
    }
    if (!value) return null;

    const kind = control.dataset.validate;
    if (kind === 'email' && !EMAIL_RE.test(value)) {
      return control.dataset.msgInvalid || 'Please enter a valid email address.';
    }
    return null;
  }

  function setError(control: Control, message: string | null) {
    const node = errorNodeFor(control);
    if (message) {
      control.setAttribute('aria-invalid', 'true');
      if (node) node.textContent = message;
    } else {
      control.removeAttribute('aria-invalid');
      if (node) node.textContent = '';
    }
  }

  function enhanceForm(form: HTMLFormElement) {
    const status = document.getElementById(`${form.id}-status`);
    const success = document.getElementById(`${form.id}-success`);
    const controls = Array.from(
      form.querySelectorAll<Control>('input[name], select[name], textarea[name]'),
    ).filter((c) => !('honeypot' in c.dataset));

    // Re-validate a field once it has been flagged, so the error clears as
    // soon as the person fixes it rather than only on the next submit.
    controls.forEach((control) => {
      control.addEventListener('blur', () => {
        if (control.getAttribute('aria-invalid') === 'true' || control.value.trim()) {
          setError(control, validate(control));
        }
      });
      control.addEventListener('input', () => {
        if (control.getAttribute('aria-invalid') === 'true') {
          setError(control, validate(control));
        }
      });
    });

    form.addEventListener('submit', async (event) => {
      // Posting is done with fetch so the visitor stays on the page. Without
      // JS the browser posts straight to `action`.
      // TODO: once the real endpoint exists, confirm it accepts
      // `Accept: application/json` (Formspree does) or adjust this call.
      event.preventDefault();

      const honeypot = form.querySelector<HTMLInputElement>('[data-honeypot]');
      if (honeypot && honeypot.value) return; // silently drop bot submissions

      const invalid: Control[] = [];
      controls.forEach((control) => {
        const message = validate(control);
        setError(control, message);
        if (message) invalid.push(control);
      });

      if (invalid.length) {
        if (status) {
          status.textContent =
            invalid.length === 1
              ? 'There is 1 problem with the form. Please check the highlighted field.'
              : `There are ${invalid.length} problems with the form. Please check the highlighted fields.`;
        }
        invalid[0].focus();
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      if (status) status.textContent = 'Sending your enquiry…';

      let ok = false;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        ok = res.ok;
      } catch {
        ok = false;
      }
      if (submit) submit.disabled = false;

      if (!ok) {
        if (status) {
          status.textContent = `Sorry, your enquiry could not be sent. Please email us at ${form.dataset.email} instead.`;
        }
        return;
      }

      if (status) status.textContent = 'Thanks, your enquiry has been sent.';
      form.hidden = true;
      if (success) {
        success.hidden = false;
        success.querySelector<HTMLElement>('h3')?.focus();
      }
      form.reset();
    });
  }

  function initContactForms() {
    document
      .querySelectorAll<HTMLFormElement>('form[data-contact-form]')
      .forEach(enhanceForm);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForms, { once: true });
  } else {
    initContactForms();
  }
</script>
