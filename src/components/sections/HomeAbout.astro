---
/** Homepage "About us" — image collage beside heading, copy, checklist, CTA. */
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const features = [
  'Solar Inverter Setup',
  'Battery Storage Solutions',
  'Solar Material Financing',
  '24 X 7 Call & Chat Support',
];
---

<section class="about section">
  <div class="container-site about__grid">
    <div class="about__media">
      <span class="about__dots" aria-hidden="true"></span>

      <div class="about__frame about__frame--main reveal-image">
        <img
          src="/images/about-1.jpg"
          alt="Rows of solar panels catching the sunrise"
          width="640"
          height="620"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="about__frame about__frame--sub reveal-image">
        <img
          src="/images/about-2.jpg"
          alt="Rooftop solar array on a modern home"
          width="440"
          height="380"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="about__content">
      <SectionHeading
        eyebrow="About us"
        title="About Green Energy Solar"
        as="h2"
        class="about__head"
      />

      <p class="about__copy" data-anim="up" data-anim-delay="0.1">
        Lorem Ipsum is simply dummy text of the printing and typesetting
        industry. Lorem Ipsum has been the industry's standard dummy text ever
        since the 1500s, when an unknown printer took a galley of type and
        scrambled.
      </p>
      <p class="about__copy" data-anim="up" data-anim-delay="0.2">
        Sed ut perspiciatis unde omnis iste natus error sit voluptatem
        accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab
        illo inventore veritatis et quasi architecto beatae vitae dicta sunt
        explicabo.
      </p>

      <ul class="about__list" data-anim="up" data-anim-delay="0.3">
        {
          features.map((item) => (
            <li class="about__item">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle class="about__tick-bg" cx="12" cy="12" r="12" />
                <path
                  class="about__tick"
                  d="m7 12.4 3.2 3.2L17 8.8"
                  fill="none"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="about__cta" data-anim="up" data-anim-delay="0.4">
        <Button href="/about-us">More About</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-py);
    background: var(--color-bg);
  }

  .about__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5rem;
    align-items: center;
  }

  /* ---- collage ---------------------------------------------------------- */
  .about__media {
    position: relative;
    padding-bottom: 5rem;
    padding-right: 3.75rem;
  }

  .about__dots {
    position: absolute;
    top: 0;
    right: 0;
    width: 9.375rem;
    height: 13.125rem;
    background-image: radial-gradient(
      var(--color-border) 2.2px,
      transparent 2.3px
    );
    background-size: 1.125rem 1.125rem;
  }

  .about__frame {
    border-radius: var(--radius-lg);
  }
  .about__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__frame--main {
    position: relative;
    width: 88%;
    aspect-ratio: 5 / 5;
    border-top-left-radius: var(--radius-pill);
    border-bottom-left-radius: var(--radius-pill);
  }

  .about__frame--sub {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 55%;
    aspect-ratio: 6 / 5;
    border: 0.625rem solid var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  /* ---- content ---------------------------------------------------------- */
  .about__content {
    max-width: 38.75rem;
  }
  .about__content :global(.about__head) {
    max-width: none;
    margin-bottom: 1.5rem;
  }

  .about__copy {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .about__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem 1.5rem;
    margin-block: 1.875rem 2.25rem;
  }
  .about__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .about__item svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
  .about__tick-bg { fill: var(--color-accent); }
  .about__tick { stroke: var(--color-on-accent); }

  @media (max-width: 1199px) {
    .about__grid {
      gap: 3rem;
    }
  }

  @media (max-width: 991px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }
    .about__content {
      max-width: none;
    }
    .about__media {
      padding-right: 2.5rem;
      padding-bottom: 3.75rem;
    }
  }

  @media (max-width: 575px) {
    .about__media {
      padding-right: 1.25rem;
      padding-bottom: 2.5rem;
    }
    .about__frame--main {
      width: 100%;
      border-top-left-radius: var(--radius-lg);
      border-bottom-left-radius: var(--radius-lg);
    }
    .about__frame--sub {
      width: 60%;
      border-width: 0.375rem;
    }
    .about__dots {
      display: none;
    }
    .about__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
