---
/**
 * "Our work process" — three numbered steps joined by a dashed arc on
 * desktop. The connector is one decorative SVG laid over the row and spanning
 * the middle two-thirds (centre of step 1 to centre of step 3), so it stays
 * aligned with the tiles at any width. It is hidden once the row stacks.
 */
import SectionHeading from '../ui/SectionHeading.astro';

interface Step {
  icon: string;
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  steps?: Step[];
  class?: string;
}

const {
  eyebrow = 'Our latest process',
  title = 'Our Work Process',
  steps = [
    {
      icon: '/images/icon-step-1.svg',
      title: 'Project Planning',
      text: 'Lorem Ipsum is simply dummy text of the printing and typesetting industry.',
    },
    {
      icon: '/images/icon-step-2.svg',
      title: 'Research & Analysis',
      text: 'Lorem Ipsum is simply dummy text of the printing and typesetting industry.',
    },
    {
      icon: '/images/icon-step-3.svg',
      title: 'Solar Installation',
      text: 'Lorem Ipsum is simply dummy text of the printing and typesetting industry.',
    },
  ],
  class: className = '',
} = Astro.props;
---

<section class:list={['process', 'section', className]} aria-label={title}>
  <div class="container-site">
    <SectionHeading eyebrow={eyebrow} title={title} align="center" class="process__head" />

    <div class="process__row">
      <svg
        class="process__connector"
        viewBox="0 0 600 80"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path class="process__line" d="M105 30 C 140 62, 170 62, 192 41" />
        <path class="process__arrow" d="M186 52 L193 40 L181 46" />
        <path class="process__line" d="M405 30 C 440 62, 470 62, 492 41" />
        <path class="process__arrow" d="M486 52 L493 40 L481 46" />
      </svg>

      {
        steps.map((step, i) => (
          <article class="process__step" data-anim="up" data-anim-delay={(0.1 + i * 0.15).toFixed(2)}>
            <div class="process__tile">
              <img src={step.icon} alt="" width="55" height="55" loading="lazy" decoding="async" />
              <span class="process__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="process__title">{step.title}</h3>
            <p class="process__text">{step.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--color-bg);
  }

  .process :global(.process__head) {
    margin-bottom: 4rem;
  }

  .process__row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  /* ---- connector ------------------------------------------------------ */
  .process__connector {
    position: absolute;
    top: 0;
    left: 16.666%;
    width: 66.666%;
    height: 8.125rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    pointer-events: none;
  }
  .process__line {
    stroke-dasharray: 6 8;
    stroke-linecap: round;
    opacity: 0.75;
  }
  .process__arrow {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- step ------------------------------------------------------------ */
  .process__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .process__tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 8.125rem;
    height: 8.125rem;
    margin-bottom: 1.75rem;
    background: var(--color-accent);
    border-radius: var(--radius-lg);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .process__tile img {
    width: 3.4375rem;
    height: 3.4375rem;
  }

  .process__step:hover .process__tile {
    transform: translateY(-6px);
  }

  .process__num {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    font-family: var(--font-display);
    font-size: var(--text-h6);
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
  }

  .process__title {
    margin: 0 0 0.75rem;
    font-size: var(--text-h4);
    color: var(--color-heading);
  }
  .process__text {
    max-width: 20rem;
    margin: 0;
    color: var(--color-text);
  }

  /* ---- responsive ------------------------------------------------------ */
  @media (max-width: 991px) {
    .process__row { grid-template-columns: minmax(0, 1fr); gap: 3rem; }
    .process__connector { display: none; }
    .process :global(.process__head) { margin-bottom: 3rem; }
  }

  @media (max-width: 575px) {
    .process__tile {
      width: 6.5rem;
      height: 6.5rem;
      margin-bottom: 1.25rem;
    }
    .process__tile img { width: 2.75rem; height: 2.75rem; }
    .process__num { width: 2.125rem; height: 2.125rem; font-size: var(--text-base); }
    .process__title { font-size: var(--text-h5); }
  }

  @media (prefers-reduced-motion: reduce) {
    .process__tile { transition: none; }
  }
</style>
