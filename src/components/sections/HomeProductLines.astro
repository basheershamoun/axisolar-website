---
/** Homepage product-line cards — one per line in `productLines`. */
import SectionHeading from '../ui/SectionHeading.astro';
import { productLines } from '../../data/site';

/* Inline line icons, keyed by route so the order of `productLines` can change. */
const icons: Record<string, string> = {
  '/solar-panels':
    '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M3 8h18M3 12h18M9 4v12M15 4v12M12 16v4M8 20h8"/>',
  '/inverters':
    '<rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M9 7h6M12.5 10.5 10.5 14h3l-2 3.5"/>',
  '/ev-chargers':
    '<path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M3.5 21h13M15 9h2a2 2 0 0 1 2 2v5a1.5 1.5 0 0 0 3 0V8l-2.5-2.5"/><path d="M10.5 7 8.5 11h3l-2 4"/>',
};
---

<section id="product-lines" class="lines section">
  <div class="container-site">
    <SectionHeading
      eyebrow="Our products"
      title="Three Lines, One Complete System"
      text="Generate, convert and charge. Spec the whole installation from a single supplier."
      align="center"
      class="lines__head"
    />

    <ul class="lines__grid">
      {
        productLines.map((line, i) => (
          <li data-anim="up" data-anim-delay={(i * 0.15).toFixed(2)}>
            <a class="line" href={line.href}>
              <span class="line__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}.</span>
              <span class="line__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[line.href]}
                />
              </span>
              <h3 class="line__title">{line.label}</h3>
              <p class="line__text">{line.summary}</p>
              <span class="line__more">
                View range
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lines { background: var(--color-bg-alt); }
  .lines :global(.lines__head) { margin-block-end: 3.75rem; }

  .lines__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.875rem;
  }

  .line {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2.5rem 2rem 2rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  /* Dark fill wipes up from the bottom on hover, like the theme's cards. */
  .line::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-bg-dark);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .line:hover,
  .line:focus-visible {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
  }
  .line:hover::before,
  .line:focus-visible::before { transform: scaleY(1); }

  .line__num {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-end: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--color-border);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .line__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-block-end: 1.75rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: var(--radius-md);
  }
  .line__icon svg { width: 2rem; height: 2rem; }

  .line__title {
    margin-block-end: 0.75rem;
    font-size: var(--text-h4);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .line__text {
    margin-block-end: 1.5rem;
    color: var(--color-text);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .line__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: auto;
    font-weight: var(--weight-medium);
    color: var(--color-accent-ink);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .line__more svg {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .line:hover .line__more svg { transform: translateX(4px); }

  .line:hover .line__title,
  .line:focus-visible .line__title { color: var(--color-on-dark); }
  .line:hover .line__text,
  .line:focus-visible .line__text { color: var(--color-on-dark-muted); }
  .line:hover .line__more,
  .line:focus-visible .line__more { color: var(--color-accent-on-dark); }
  .line:hover .line__num,
  .line:focus-visible .line__num { color: var(--color-border-dark); }

  @media (max-width: 991px) {
    .lines__grid { grid-template-columns: minmax(0, 1fr); max-width: 36rem; margin-inline: auto; }
  }
  @media (max-width: 767px) {
    .lines :global(.lines__head) { margin-block-end: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line, .line::before, .line__more svg { transition: none; }
  }
</style>
