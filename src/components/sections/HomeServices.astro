---
/** Homepage services grid — the original's carousel, flattened into a grid. */
import SectionHeading from '../ui/SectionHeading.astro';

interface Service {
  title: string;
  slug: string;
  image: string;
  icon: string;
}

const blurb =
  'Aenean mattis mauris turpis, quis porta magna aliquam eu. Nulla consectetur.';

/* Line icons are inline so the cards never wait on a network request. */
const icons = {
  maintenance:
    '<path d="M14.5 3.5a5 5 0 0 0-6.6 6.2L3 14.6 5.4 17l4.9-4.9a5 5 0 0 0 6.2-6.6l-2.6 2.6-2-2 2.6-2.6Z"/><path d="M15 14.5 20 19.5"/>',
  solutions:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/>',
  saving:
    '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M3 8h18M3 12h18M9 4v12M15 4v12M12 16v4M8 20h8"/>',
  hybrid:
    '<path d="M4 20V9.5L12 4l8 5.5V20"/><path d="M9.5 20v-5h5v5"/><path d="M12 7.5 10.5 11h3L12 14"/>',
  renewable:
    '<path d="M12 12c0-4 2-7 6-8-1 5-3 7-6 8Z"/><path d="M12 12c-4 0-7-2-8-6 5 1 7 3 8 6Z"/><path d="M12 12v9"/><path d="M6 21h12"/>',
  pv: '<rect x="3" y="5" width="18" height="10" rx="1"/><path d="M3 10h18M9.5 5l-1 10M14.5 5l1 10M12 15v4M9 19h6"/>',
};

const services: Service[] = [
  { title: 'Solar Maintenance', slug: 'solar-maintenance', image: '/images/service-1.jpg', icon: icons.maintenance },
  { title: 'Solar Solutions', slug: 'solar-solutions', image: '/images/service-3.jpg', icon: icons.solutions },
  { title: 'Energy Saving Devices', slug: 'energy-saving-devices', image: '/images/service-2.jpg', icon: icons.saving },
  { title: 'Hybrid Energy', slug: 'hybrid-energy', image: '/images/service-5.jpg', icon: icons.hybrid },
  { title: 'Renewable Energy', slug: 'renewable-energy', image: '/images/service-6.jpg', icon: icons.renewable },
  { title: 'Solar PV Systems', slug: 'solar-pv-systems', image: '/images/service-4.jpg', icon: icons.pv },
];
---

<section class="svcs section">
  <div class="container-site">
    <SectionHeading
      eyebrow="Our services"
      title="Best Offer For Renewable Energy"
      align="center"
      as="h2"
      class="svcs__head"
    />

    <ul class="svcs__grid">
      {
        services.map((service, i) => (
          <li class="svcs__cell" data-anim="up" data-anim-delay={(i * 0.15).toFixed(2)}>
            <article class="svc">
              <div class="svc__media">
                <img
                  src={service.image}
                  alt={service.title}
                  width="420"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <span class="svc__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={service.icon}
                ></svg>
              </span>

              <div class="svc__body">
                <h3 class="svc__title">
                  <a href={`/services/${service.slug}`}>{service.title}</a>
                </h3>
                <p class="svc__text">{blurb}</p>
                <a class="svc__more" href={`/services/${service.slug}`}>
                  <span>Read More</span>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .svcs {
    padding-block: var(--section-py);
    background: var(--color-bg-alt);
  }

  .svcs :global(.svcs__head) {
    margin-bottom: 3.75rem;
  }

  .svcs__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.875rem;
  }

  /* ---- card ------------------------------------------------------------- */
  .svc {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    min-height: 28.125rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-dark);
  }

  .svc__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .svc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .svc:hover .svc__media img {
    transform: scale(1.06);
  }

  .svc__icon {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .svc__icon svg {
    width: 1.75rem;
    height: 1.75rem;
    stroke: currentColor;
  }
  .svc:hover .svc__icon {
    background: var(--color-white);
  }

  .svc__body {
    padding: 1.375rem 1.5rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .svc__title {
    margin-bottom: 0.625rem;
    font-size: var(--text-h5);
    line-height: 1.25;
  }
  .svc__title a {
    color: var(--color-heading);
  }
  .svc:hover .svc__title a {
    color: var(--color-primary);
  }

  .svc__text {
    margin-bottom: 0.875rem;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .svc__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
  }
  .svc__more svg {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .svc:hover .svc__more {
    color: var(--color-heading);
  }
  .svc:hover .svc__more svg {
    transform: translateX(4px);
  }

  @media (max-width: 991px) {
    .svcs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .svcs :global(.svcs__head) {
      margin-bottom: 2.5rem;
    }
  }

  @media (max-width: 575px) {
    .svcs__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .svc {
      min-height: 25rem;
    }
    .svc__icon {
      width: 3rem;
      height: 3rem;
    }
    .svc__icon svg {
      width: 1.375rem;
      height: 1.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc__media img,
    .svc__more svg {
      transition: none;
    }
  }
</style>
