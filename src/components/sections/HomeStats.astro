---
/**
 * Headline product figures — the dark strip under "Why choose us".
 * Real maximums from the datasheets, not marketing counts.
 *
 * The counter helper writes into `textContent` of its own element, so the
 * unit lives in a sibling <span>.
 */
interface Stat {
  value: number;
  unit: string;
  label: string;
  icon: 'panel' | 'inverter' | 'ac' | 'dc';
}

const stats: Stat[] = [
  { value: 640, unit: 'W',  label: 'Max module power',     icon: 'panel' },
  { value: 20,  unit: 'kW', label: 'Max hybrid inverter',  icon: 'inverter' },
  { value: 22,  unit: 'kW', label: 'Max AC charging',      icon: 'ac' },
  { value: 240, unit: 'kW', label: 'Max DC fast charging', icon: 'dc' },
];

const paths: Record<Stat['icon'], string> = {
  panel: 'M3 4h18v12H3zM3 8h18M3 12h18M9 4v12M15 4v12M12 16v4M8 20h8',
  inverter: 'M7 2.5h10a2 2 0 0 1 2 2v15a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-15a2 2 0 0 1 2-2ZM9 7h6M12.5 10.5 10.5 14h3l-2 3.5',
  ac: 'M7 3h10v18H7zM10 7h4M4 12c1-1.5 2-1.5 3 0M17 12c1 1.5 2 1.5 3 0',
  dc: 'M13 2 4 14h7l-1 8 9-12h-7l1-8Z',
};
---

<section class="stats" aria-label="AXI SOLAR range in figures">
  <div class="container-site">
    <ul class="stats__list">
      {
        stats.map((stat, i) => (
          <li class="stat" data-anim="up" data-anim-delay={(i * 0.12).toFixed(2)}>
            <span class="stat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d={paths[stat.icon]} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>

            <span class="stat__text">
              <span class="stat__value">
                {/* Counter target — its textContent is replaced each frame. */}
                <span class="stat__number" data-count-to={String(stat.value)}>{stat.value}</span>
                <span class="stat__suffix">&nbsp;{stat.unit}</span>
              </span>
              <span class="stat__label">{stat.label}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    padding-block: 3.125rem;
    background: var(--color-bg-dark);
    color: var(--color-on-dark);
  }

  .stats__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.875rem;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* Hairline dividers, matching the original strip. */
  .stat + .stat { border-inline-start: 1px solid var(--color-border-dark); padding-inline-start: 1.875rem; }

  .stat__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: 50%;
  }
  .stat__icon svg { width: 1.625rem; height: 1.625rem; }

  .stat__text { display: flex; flex-direction: column; min-width: 0; }

  .stat__value {
    display: flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    color: var(--color-on-dark);
  }
  .stat__suffix { color: var(--color-accent-on-dark); }

  .stat__label {
    font-size: var(--text-base);
    color: var(--color-on-dark-muted);
  }

  @media (max-width: 991px) {
    .stats__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    /* Dividers only make sense between items on the same row. */
    .stat + .stat { border-inline-start: 0; padding-inline-start: 0; }
  }

  @media (max-width: 575px) {
    .stats { padding-block: 2.5rem; }
    /* One per row left ~200px of every row empty; 2-up reads as a band. */
    .stats__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 0.75rem; }
    .stat__icon { width: 3rem; height: 3rem; }
    .stat__icon svg { width: 1.375rem; height: 1.375rem; }
  }
</style>
