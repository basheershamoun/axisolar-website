---
/**
 * "Why choose us" — image pair on the left, icon-led benefit points on the
 * right. Mirrors the original's `why-choose-us-item` blocks (Efficiency &
 * Power / Trust & Warranty / High Quality Work / 24*7 Support).
 *
 * The icons are inline SVGs so they inherit `currentColor` and can be tinted
 * from tokens on hover without shipping four extra network requests.
 */
import SectionHeading from '../ui/SectionHeading.astro';

interface Point {
  icon: 'power' | 'shield' | 'quality' | 'support';
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  image?: string;
  imageAlt?: string;
  insetImage?: string;
  insetAlt?: string;
  points?: Point[];
  class?: string;
}

const {
  eyebrow = 'Why choose us',
  title = 'Providing Solar Energy Solutions',
  text = 'It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.',
  image = '/images/whyus-1.jpg',
  imageAlt = 'Engineer inspecting a rooftop solar array',
  insetImage = '/images/whyus-2.jpg',
  insetAlt = 'Close-up of photovoltaic panels in sunlight',
  points = [
    {
      icon: 'power',
      title: 'Efficiency & Power',
      text: 'Ut ut eros risus. In luctus fringilla augue, eget ultricies purus. Sed mauris a nisl.',
    },
    {
      icon: 'shield',
      title: 'Trust & Warranty',
      text: 'Ut ut eros risus. In luctus fringilla augue, eget ultricies purus. Sed mauris a nisl.',
    },
    {
      icon: 'quality',
      title: 'High Quality Work',
      text: 'Ut ut eros risus. In luctus fringilla augue, eget ultricies purus. Sed mauris a nisl.',
    },
    {
      icon: 'support',
      title: '24*7 Support',
      text: 'Ut ut eros risus. In luctus fringilla augue, eget ultricies purus. Sed mauris a nisl.',
    },
  ],
  class: className = '',
} = Astro.props;
---

<section class:list={['whychoose', 'section', className]} aria-label={title}>
  <div class="container-site whychoose__inner">
    <div class="whychoose__media">
      <div class="reveal-image whychoose__shot">
        <img src={image} alt={imageAlt} width="620" height="620" loading="lazy" decoding="async" />
      </div>
      <div class="reveal-image whychoose__inset" data-anim="up" data-anim-delay="0.25">
        <img src={insetImage} alt={insetAlt} width="300" height="240" loading="lazy" decoding="async" />
      </div>
    </div>

    <div class="whychoose__content">
      <SectionHeading eyebrow={eyebrow} title={title} text={text} class="whychoose__head" />

      <ul class="whychoose__list">
        {
          points.map((point, i) => (
            <li class="whychoose__item" data-anim="up" data-anim-delay={(0.1 + i * 0.1).toFixed(2)}>
              <span class="whychoose__icon" aria-hidden="true">
                {point.icon === 'power' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
                  </svg>
                )}
                {point.icon === 'shield' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3 4 6v6c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V6l-8-3Z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {point.icon === 'quality' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="9" r="5" />
                    <path d="m8.5 13.5-1.5 7 5-2.6 5 2.6-1.5-7" />
                  </svg>
                )}
                {point.icon === 'support' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
                    <path d="M4 14h2.5a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-4ZM20 14h-2.5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1H19a1 1 0 0 0 1-1v-4Z" />
                    <path d="M18 19v.5a2.5 2.5 0 0 1-2.5 2.5H13" />
                  </svg>
                )}
              </span>
              <div class="whychoose__body">
                <h3 class="whychoose__title">{point.title}</h3>
                <p class="whychoose__text">{point.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .whychoose {
    background: var(--color-bg);
    overflow: hidden;
  }

  .whychoose__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 5rem;
  }

  /* ---- media -------------------------------------------------------- */
  .whychoose__media {
    position: relative;
    padding-bottom: 3.5rem;
    padding-left: 3.5rem;
  }

  .whychoose__shot {
    border-radius: var(--radius-lg);
  }
  .whychoose__shot img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .whychoose__inset {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 52%;
    padding: 0.625rem;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .whychoose__inset img {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* ---- content ------------------------------------------------------ */
  .whychoose__content :global(.whychoose__head) {
    max-width: none;
    margin-bottom: 2.25rem;
  }

  .whychoose__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2rem;
  }

  .whychoose__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .whychoose__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: var(--radius-md);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .whychoose__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .whychoose__item:hover .whychoose__icon {
    color: var(--color-accent);
    background: var(--color-primary);
    transform: translateY(-3px);
  }

  .whychoose__title {
    margin: 0 0 0.375rem;
    font-size: var(--text-h5);
    color: var(--color-heading);
  }
  .whychoose__text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  /* ---- responsive --------------------------------------------------- */
  @media (max-width: 1199px) {
    .whychoose__inner { gap: 3rem; }
    .whychoose__list { gap: 1.5rem; }
  }

  @media (max-width: 991px) {
    .whychoose__inner { grid-template-columns: minmax(0, 1fr); gap: 3rem; }
    .whychoose__media { max-width: 34rem; }
  }

  @media (max-width: 575px) {
    .whychoose__media { padding-left: 0; padding-bottom: 0; }
    .whychoose__inset { display: none; }
    .whychoose__list { grid-template-columns: minmax(0, 1fr); }
    .whychoose__icon { width: 2.75rem; height: 2.75rem; }
    .whychoose__icon svg { width: 1.25rem; height: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .whychoose__icon { transition: none; }
  }
</style>
