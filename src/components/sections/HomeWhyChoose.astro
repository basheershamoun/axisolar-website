---
/**
 * "Why choose AXI SOLAR" — image pair on one side, icon-led benefit points on
 * the other. Icons are inline SVGs so they inherit `currentColor`.
 */
import SectionHeading from '../ui/SectionHeading.astro';

interface Point {
  icon: 'quality' | 'innovation' | 'system' | 'docs';
  title: string;
  text: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  image?: string;
  imageAlt?: string;
  insetImage?: string;
  insetAlt?: string;
  points?: Point[];
  class?: string;
}

const {
  eyebrow = 'Why choose us',
  title = 'Why Choose AXI SOLAR',
  text = 'What we offer the installers, distributors and engineers who build with our products.',
  image = '/images/axi/panel-row.webp',
  imageAlt = 'Row of bifacial solar panels on a ground-mount frame',
  insetImage = '/images/axi/engineers.webp',
  insetAlt = 'Engineers installing solar panels at sunset',
  points = [
    {
      icon: 'quality',
      title: 'Exceptional Quality',
      text: 'Products built to exceed industry standards, with strict quality control so they last.',
    },
    {
      icon: 'innovation',
      title: 'Expertise & Innovation',
      text: 'Current technology such as N-type bifacial cells, backed by solid engineering.',
    },
    {
      icon: 'system',
      title: 'Complete System',
      text: 'Panels, hybrid inverters and EV charging from one supplier, specified to work together.',
    },
    {
      icon: 'docs',
      title: 'Datasheets & Support',
      text: 'A full datasheet for every product, and direct technical answers for installers.',
    },
  ],
  class: className = '',
} = Astro.props;
---

<section class:list={['whychoose', 'section', className]} aria-label={title}>
  <div class="container-site whychoose__inner">
    <div class="whychoose__media">
      <div class="reveal-image whychoose__shot">
        <img src={image} alt={imageAlt} width="620" height="620" loading="lazy" decoding="async" />
      </div>
      <div class="reveal-image whychoose__inset" data-anim="up" data-anim-delay="0.25">
        <img src={insetImage} alt={insetAlt} width="300" height="240" loading="lazy" decoding="async" />
      </div>
    </div>

    <div class="whychoose__content">
      <SectionHeading eyebrow={eyebrow} title={title} text={text} class="whychoose__head" />

      <ul class="whychoose__list">
        {
          points.map((point, i) => (
            <li class="whychoose__item" data-anim="up" data-anim-delay={(0.1 + i * 0.1).toFixed(2)}>
              <span class="whychoose__icon" aria-hidden="true">
                {point.icon === 'innovation' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
                  </svg>
                )}
                {point.icon === 'system' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="8.5" y="14" width="7" height="7" rx="1" />
                    <path d="M6.5 10v2h11v-2M12 12v2" />
                  </svg>
                )}
                {point.icon === 'quality' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="9" r="5" />
                    <path d="m8.5 13.5-1.5 7 5-2.6 5 2.6-1.5-7" />
                  </svg>
                )}
                {point.icon === 'docs' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
                    <path d="M14 3v5h5M12 11v6M9 14l3 3 3-3" />
                  </svg>
                )}
              </span>
              <div class="whychoose__body">
                <h3 class="whychoose__title">{point.title}</h3>
                <p class="whychoose__text">{point.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .whychoose {
    background: var(--color-bg);
    overflow: hidden;
  }

  .whychoose__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 5rem;
  }

  /* ---- media -------------------------------------------------------- */
  .whychoose__media {
    position: relative;
    padding-block-end: 3.5rem;
    padding-inline-start: 3.5rem;
  }

  .whychoose__shot {
    border-radius: var(--radius-lg);
  }
  .whychoose__shot img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .whychoose__inset {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    width: 52%;
    padding: 0.625rem;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .whychoose__inset img {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* ---- content ------------------------------------------------------ */
  .whychoose__content :global(.whychoose__head) {
    max-width: none;
    margin-block-end: 2.25rem;
  }

  .whychoose__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2rem;
  }

  .whychoose__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .whychoose__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: var(--radius-md);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .whychoose__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .whychoose__item:hover .whychoose__icon {
    color: var(--color-accent);
    background: var(--color-primary);
    transform: translateY(-3px);
  }

  .whychoose__title {
    margin-block: 0 0.375rem;
    font-size: var(--text-h5);
    color: var(--color-heading);
  }
  .whychoose__text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  /* ---- responsive --------------------------------------------------- */
  @media (max-width: 1199px) {
    .whychoose__inner { gap: 3rem; }
    .whychoose__list { gap: 1.5rem; }
  }

  @media (max-width: 991px) {
    .whychoose__inner { grid-template-columns: minmax(0, 1fr); gap: 3rem; }
    .whychoose__media { max-width: 34rem; }
  }

  @media (max-width: 575px) {
    .whychoose__media { padding-inline-start: 0; padding-block-end: 0; }
    .whychoose__inset { display: none; }
    .whychoose__list { grid-template-columns: minmax(0, 1fr); }
    .whychoose__icon { width: 2.75rem; height: 2.75rem; }
    .whychoose__icon svg { width: 1.25rem; height: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .whychoose__icon { transition: none; }
  }
</style>
