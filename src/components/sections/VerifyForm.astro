---
/**
 * Serial-number verification.
 *
 * TODO: wire to the real serial database. Keep `name="product_serial"` — the
 * old site posted that field and the lookup will expect it. Until the backend
 * exists, submitting shows an inline message and makes no network call.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { site } from '../../data/site';
---

<section class="section verify" aria-label="Verify a product">
  <div class="container-site verify__inner">
    <SectionHeading
      eyebrow="Product verification"
      title="Check Your Serial Number"
      text="Confirm that your AXI SOLAR product is genuine. Enter the serial number printed on the product's rating label."
      align="center"
    />

    <form class="verify__form" action="/verify" method="get" novalidate data-verify-form data-anim="up">
      <label for="product-serial">Serial number</label>
      <div class="verify__row">
        <input
          id="product-serial"
          name="product_serial"
          type="text"
          autocomplete="off"
          spellcheck="false"
          required
          aria-required="true"
          aria-describedby="product-serial-error"
        />
        <button type="submit" class="verify__submit">Verify</button>
      </div>
      <p class="verify__error" id="product-serial-error"></p>
    </form>

    <div class="verify__result" role="status" aria-live="polite" data-verify-result></div>
    <template data-verify-message>
      <p>
        Online verification is coming soon. Email <a href={`mailto:${site.email}`}>{site.email}</a> with your
        serial number and we'll confirm it.
      </p>
    </template>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-verify-form]');
  const result = document.querySelector<HTMLElement>('[data-verify-result]');
  const tpl = document.querySelector<HTMLTemplateElement>('[data-verify-message]');
  const input = form?.querySelector<HTMLInputElement>('input[name="product_serial"]');
  const error = document.getElementById('product-serial-error');

  form?.addEventListener('submit', (event) => {
    // TODO: replace with the real lookup (POST/GET product_serial to the API).
    event.preventDefault();
    if (!input || !result || !tpl) return;

    if (!input.value.trim()) {
      input.setAttribute('aria-invalid', 'true');
      if (error) error.textContent = 'Please enter a serial number.';
      input.focus();
      return;
    }
    input.removeAttribute('aria-invalid');
    if (error) error.textContent = '';
    result.replaceChildren(tpl.content.cloneNode(true));
  });
</script>

<style>
  .verify__inner { max-width: 46rem; }
  .verify__form { margin-block-start: 2.5rem; }
  .verify__form label {
    display: block;
    margin-block-end: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }
  .verify__row { display: flex; gap: 0.75rem; }
  .verify__row input {
    flex: 1;
    min-width: 0;
    padding: 0.9375rem 1.25rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-heading);
    background: var(--color-bg-alt);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
  }
  .verify__row input:focus { background: var(--color-white); border-color: var(--color-accent); }
  .verify__row input[aria-invalid='true'] { border-color: var(--color-heading); }

  .verify__submit {
    flex: none;
    padding: 0.9375rem 2.25rem;
    font-weight: var(--weight-medium);
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .verify__submit:hover, .verify__submit:focus-visible { background: var(--color-primary); }

  .verify__error { margin-block-start: 0.5rem; font-size: var(--text-sm); color: var(--color-heading); }
  .verify__error:empty { display: none; }

  .verify__result:empty { display: none; }
  .verify__result {
    margin-block-start: 1.5rem;
    padding: 1.25rem 1.5rem;
    color: var(--color-heading);
    background: var(--color-parchment);
    border: 1px solid var(--color-border);
    border-inline-start: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
  }
  .verify__result :global(p) { margin: 0; }
  .verify__result :global(a) { color: var(--color-accent-ink); text-decoration: underline; }

  @media (max-width: 480px) {
    .verify__row { flex-direction: column; }
  }
</style>
