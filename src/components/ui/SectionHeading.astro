---
/** Eyebrow + split-animated title + optional lead paragraph. */
import SplitText from './SplitText.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  /** `chars` gives the tighter per-letter reveal used on hero headings. */
  split?: 'words' | 'chars';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  text,
  align = 'left',
  tone = 'dark',
  split = 'words',
  as = 'h2',
  class: className = '',
} = Astro.props;
---

<div class:list={['sec-head', `is-${align}`, `tone-${tone}`, className]}>
  {eyebrow && <span class="sec-head__eyebrow" data-anim="up">{eyebrow}</span>}
  <SplitText text={title} mode={split} as={as} class="sec-head__title" />
  {text && <p class="sec-head__text" data-anim="up" data-anim-delay="0.15">{text}</p>}
  <slot />
</div>

<style>
  .sec-head { max-width: 46.25rem; }
  .is-center { margin-inline: auto; text-align: center; }

  .sec-head__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-forest);
  }
  .sec-head__eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: var(--color-accent);
  }
  .is-center .sec-head__eyebrow::after {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: var(--color-accent);
  }

  .sec-head__title { margin-bottom: 1rem; }
  .sec-head__text { color: var(--color-text); font-size: var(--text-lead); }

  .tone-light .sec-head__eyebrow { color: var(--color-accent); }
  .tone-light :global(.sec-head__title) { color: var(--color-white); }
  .tone-light .sec-head__text { color: var(--color-on-dark-muted); }
</style>
