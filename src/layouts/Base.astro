---
/**
 * Base document shell. Owns <head>, the shared header/footer and the single
 * client-side entry point that boots the motion layer.
 */
import '@fontsource/rajdhani/400.css';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource-variable/rubik';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Transparent header sits over a full-bleed hero (homepage style). */
  transparentHeader?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = 'Solor — renewable energy solutions that power the future. Solar PV systems, hybrid energy and maintenance services.',
  transparentHeader = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header transparent={transparentHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import { initAnimations } from '../lib/animations';

      const boot = () => initAnimations(document);

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, { once: true });
      } else {
        boot();
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: var(--z-overlay);
        padding: 0.75rem 1.25rem;
        background: var(--color-accent);
        color: var(--color-forest);
        font-weight: var(--weight-semibold);
        border-radius: 0 0 var(--radius-md) 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
