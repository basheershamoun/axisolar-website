---
import Base from '../layouts/Base.astro';
import SplitText from '../components/ui/SplitText.astro';
import Button from '../components/ui/Button.astro';
import { productLines } from '../data/site';

const links = [
  ...productLines.map(({ label, href, summary }) => ({ label, href, summary })),
  { label: 'Downloads', href: '/downloads', summary: 'Datasheets, manuals and certificates for every product.' },
  { label: 'Verify', href: '/verify', summary: 'Check that your AXI SOLAR product is genuine.' },
];
---

<Base
  title="Page not found — AXI SOLAR"
  description="The page you were looking for does not exist. Find AXI SOLAR solar panels, hybrid inverters, EV chargers, downloads and product verification."
>
  <meta slot="head" name="robots" content="noindex" />

  <section class="nf" aria-labelledby="nf-title">
    <img class="nf__bg" src="/images/axi/panel-row.webp" alt="" decoding="async" fetchpriority="high" />
    <span class="nf__scrim" aria-hidden="true"></span>

    <div class="container-site nf__inner">
      <p class="nf__code" data-anim="up"><span class="sr-only">Error </span>404</p>
      <SplitText text="Page not found" mode="chars" as="h1" class="nf__title" />
      <p class="nf__text" data-anim="up" data-anim-delay="0.15">
        The page you requested has moved or never existed. Head back home, or jump straight to what you need below.
      </p>
      <div class="nf__actions" data-anim="up" data-anim-delay="0.3">
        <Button href="/" size="lg" class="nf__primary">Back to home</Button>
        <Button href="/contact" size="lg" class="nf__ghost">Contact us</Button>
      </div>

      <nav class="nf__looking" aria-labelledby="nf-looking">
        <h2 id="nf-looking" class="nf__looking-title" data-anim="up">Looking for…</h2>
        <ul class="nf__grid">
          {links.map((l, i) => (
            <li data-anim="up" data-anim-delay={(0.1 + i * 0.05).toFixed(2)}>
              <a class="nf__card" href={l.href}>
                <span class="nf__card-label">{l.label}</span>
                <span class="nf__card-text">{l.summary}</span>
                <svg class="nf__card-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-bg-dark);
  }
  .nf__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }
  .nf__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--color-overlay), var(--color-bg-dark));
  }

  .nf__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--section-py);
    text-align: center;
  }

  .nf__code {
    margin-block-end: 0.5rem;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(7rem, 22vw, 15rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-accent-on-dark);
  }

  .nf :global(.nf__title) {
    margin-block-end: 1rem;
    color: var(--color-on-dark);
    text-wrap: balance;
  }
  .nf__text {
    max-width: 36rem;
    margin-block-end: 2.25rem;
    color: var(--color-on-dark-muted);
    font-size: var(--text-lead);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  /* Default hover fills forest, which disappears on this dark surface. */
  .nf__actions :global(.nf__primary) {
    --btn-bg-hover: var(--color-on-dark);
    --btn-fg-hover: var(--color-heading);
    --btn-border-hover: var(--color-on-dark);
  }
  .nf__actions :global(.nf__ghost) {
    --btn-bg: transparent;
    --btn-fg: var(--color-on-dark);
    --btn-border: var(--color-on-dark);
    --btn-bg-hover: var(--color-on-dark);
    --btn-fg-hover: var(--color-heading);
    --btn-border-hover: var(--color-on-dark);
  }

  .nf__looking {
    width: 100%;
    margin-block-start: 4.5rem;
    padding-block-start: 3rem;
    border-block-start: 1px solid var(--color-border-dark);
  }
  .nf__looking-title {
    margin-block-end: 1.75rem;
    font-size: var(--text-h4);
    color: var(--color-on-dark);
  }

  .nf__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
    text-align: start;
  }
  .nf__grid li { display: flex; }

  .nf__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    padding: 1.5rem;
    padding-inline-end: 3rem;
    background: var(--color-white-12);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-lg);
    color: var(--color-on-dark);
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .nf__card:hover,
  .nf__card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    background: var(--color-charcoal);
  }
  .nf__card-label {
    font-family: var(--font-display);
    font-size: var(--text-h5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-display);
  }
  .nf__card-text {
    font-size: var(--text-sm);
    color: var(--color-on-dark-muted);
  }
  .nf__card-arrow {
    position: absolute;
    inset-block-start: 1.6rem;
    inset-inline-end: 1.25rem;
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-on-dark);
    transition: translate var(--dur-fast) var(--ease-out);
  }
  .nf__card:hover .nf__card-arrow { translate: 3px 0; }
  .nf__card-arrow:dir(rtl) { transform: scaleX(-1); }
  .nf__card:hover .nf__card-arrow:dir(rtl) { translate: -3px 0; }

  @media (max-width: 1199px) {
    .nf__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .nf__grid { grid-template-columns: minmax(0, 1fr); }
    .nf__looking { margin-block-start: 3rem; padding-block-start: 2.5rem; }
  }
</style>
