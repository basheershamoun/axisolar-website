---
/** Single post — article column plus the blog sidebar. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import BlogSidebar from '../../components/sections/BlogSidebar.astro';
import Button from '../../components/ui/Button.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      posts,
      /** Newer post (the list runs newest-first). */
      next: i > 0 ? posts[i - 1] : undefined,
      /** Older post. */
      prev: i < posts.length - 1 ? posts[i + 1] : undefined,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  posts: CollectionEntry<'blog'>[];
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { post, posts, prev, next } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const published = dateFmt.format(post.data.pubDate);
---

<Base title={`${post.data.title} — Solor`} description={post.data.description}>
  <PageHero
    title={post.data.title}
    crumbs={[{ label: 'Blog', href: '/blog' }, { label: post.data.title }]}
  />

  <section class="section">
    <div class="container-site post-layout">
      <article class="post">
        <figure class="post__media reveal-image">
          <img
            src={post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            width="1200"
            height="675"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        <ul class="post__meta" data-anim="up">
          <li>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="1.5" y="2.5" width="13" height="12" rx="2" />
              <path d="M1.5 6.5h13M5 1v3M11 1v3" />
            </svg>
            <time datetime={post.data.pubDate.toISOString()}>{published}</time>
          </li>
          <li>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="5" r="2.6" />
              <path d="M2.6 14c.6-2.8 2.7-4.3 5.4-4.3S12.8 11.2 13.4 14" />
            </svg>
            <span>{post.data.author}</span>
          </li>
          <li>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8.3 1.5H14.5v6.2L8 14.2 1.8 8 8.3 1.5Z" />
            </svg>
            <a href={`/blog?category=${encodeURIComponent(post.data.category)}`}>
              {post.data.category}
            </a>
          </li>
          {post.data.readingTime && (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="6.3" />
                <path d="M8 4.4V8l2.4 1.6" />
              </svg>
              <span>{post.data.readingTime}</span>
            </li>
          )}
        </ul>

        <div class="post__body">
          <p class="post__lead">{post.data.description}</p>
          <Content />
        </div>

        {post.data.tags.length > 0 && (
          <div class="post__tags">
            <h2>Tags</h2>
            <ul>
              {post.data.tags.map((tag) => (
                <li>
                  <a href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {post.data.authorBio && (
          <div class="author-card" data-anim="up">
            {post.data.authorImage && (
              <img
                src={post.data.authorImage}
                alt=""
                width="200"
                height="200"
                loading="lazy"
                decoding="async"
              />
            )}
            <div>
              <h2>{post.data.author}</h2>
              {post.data.authorRole && (
                <p class="author-card__role">{post.data.authorRole}</p>
              )}
              <p>{post.data.authorBio}</p>
            </div>
          </div>
        )}

        {(prev || next) && (
          <nav class="post-nav" aria-label="More posts">
            {prev ? (
              <a class="post-nav__link is-prev" href={`/blog/${prev.id}/`} rel="prev">
                <span class="post-nav__label">
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M14 8H3M7 4 3 8l4 4" />
                  </svg>
                  Previous post
                </span>
                <span class="post-nav__title">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="post-nav__link is-next" href={`/blog/${next.id}/`} rel="next">
                <span class="post-nav__label">
                  Next post
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M2 8h11M9 4l4 4-4 4" />
                  </svg>
                </span>
                <span class="post-nav__title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <p class="post__back">
          <Button href="/blog" variant="outline">Back to all posts</Button>
        </p>
      </article>

      <BlogSidebar posts={posts} currentId={post.id} class="post-layout__side" />
    </div>
  </section>
</Base>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.75rem 2.5rem;
  }
  @media (min-width: 62rem) {
    .post-layout { grid-template-columns: minmax(0, 1fr) 21.25rem; }
  }

  .post { min-width: 0; }

  .post__media {
    margin: 0 0 1.875rem;
    border-radius: var(--radius-lg);
  }
  .post__media img { width: 100%; }

  /* ----------------------------------------------------------- post meta */
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1.75rem;
    margin-bottom: 1.875rem;
    padding-bottom: 1.5rem;
    font-size: var(--text-sm);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }
  .post__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .post__meta svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .post__meta a:hover { color: var(--color-primary); }

  /* --------------------------------------------------------------- prose
     The markdown is rendered outside this component's scope, so the body
     rules are global but namespaced under `.post__body`. */
  .post__lead {
    margin-bottom: 1.75rem;
    font-size: var(--text-lead);
    font-weight: var(--weight-medium);
    line-height: 1.7;
    color: var(--color-heading);
  }

  .post__body {
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text);
  }

  .post__body :global(p) { margin: 0 0 1.375rem; }

  .post__body :global(h2) {
    margin: 2.75rem 0 1rem;
    font-size: var(--text-h3);
    color: var(--color-heading);
  }
  .post__body :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: var(--text-h4);
    color: var(--color-heading);
  }
  .post__body :global(h4) {
    margin: 1.75rem 0 0.625rem;
    font-size: var(--text-h5);
    color: var(--color-heading);
  }

  .post__body :global(strong) {
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }

  .post__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .post__body :global(a:hover) { color: var(--color-text); }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
    display: grid;
    gap: 0.625rem;
  }
  .post__body :global(ul) { list-style: disc; }
  .post__body :global(ol) { list-style: decimal; }
  .post__body :global(li) { padding-left: 0.25rem; }
  .post__body :global(li::marker) { color: var(--color-accent); }
  .post__body :global(ol li::marker) {
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
  }

  .post__body :global(blockquote) {
    margin: 2rem 0;
    padding: 1.875rem 2rem;
    font-family: var(--font-display);
    font-size: var(--text-h5);
    font-weight: var(--weight-semibold);
    line-height: 1.45;
    color: var(--color-heading);
    background: var(--color-bg-alt);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
  }
  .post__body :global(blockquote p:last-child) { margin-bottom: 0; }

  .post__body :global(img) {
    width: 100%;
    margin: 2rem 0;
    border-radius: var(--radius-lg);
  }

  .post__body :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .post__body :global(code) {
    padding: 0.125rem 0.375rem;
    font-size: 0.9em;
    color: var(--color-heading);
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
  }

  /* ---------------------------------------------------------------- tags */
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .post__tags h2 {
    margin: 0;
    font-size: var(--text-h6);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .post__tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .post__tags a {
    display: inline-block;
    padding: 0.375rem 0.9375rem;
    font-size: var(--text-sm);
    color: var(--color-heading);
    background: var(--color-bg-alt);
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .post__tags a:hover {
    color: var(--color-on-accent);
    background: var(--color-accent);
  }

  /* --------------------------------------------------------- author card */
  .author-card {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding: 1.875rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
  }
  .author-card img {
    width: 6.25rem;
    height: 6.25rem;
    flex: none;
    object-fit: cover;
    border-radius: 50%;
  }
  .author-card h2 {
    margin: 0 0 0.25rem;
    font-size: var(--text-h4);
  }
  .author-card__role {
    margin: 0 0 0.625rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .author-card p:last-child { color: var(--color-text); }

  /* ------------------------------------------------------------ post nav */
  .post-nav {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 40rem) {
    .post-nav { grid-template-columns: 1fr 1fr; }
  }

  .post-nav__link {
    display: grid;
    gap: 0.5rem;
    padding: 1.375rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .post-nav__link:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-accent);
  }
  .post-nav__link.is-next { text-align: right; }

  .post-nav__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .post-nav__link.is-next .post-nav__label { justify-content: flex-end; }
  .post-nav__label svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .post-nav__title {
    font-family: var(--font-display);
    font-size: var(--text-h5);
    font-weight: var(--weight-bold);
    line-height: 1.25;
    color: var(--color-heading);
  }

  .post__back { margin-top: 2.5rem; }

  @media (max-width: 26rem) {
    .author-card { padding: 1.25rem; }
    .post-nav__link { padding: 1.125rem; }
  }
</style>
