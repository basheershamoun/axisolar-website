---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import { site } from '../data/site';
---

<Base
  title="Contact Us — AXI SOLAR"
  description={`Talk to AXI SOLAR sales about solar panels, hybrid inverters and EV chargers. Email ${site.email} or send an enquiry.`}
>
  {/* PageHero owns the page's single <h1>. */}
  <PageHero title="Get in Touch" crumbs={[{ label: 'Contact' }]} image="/images/axi/solar-farm.webp" />

  <section class="section contact" aria-label="Contact AXI SOLAR">
    <div class="container-site contact__grid">
      <aside class="contact__aside">
        <SectionHeading
          eyebrow="Sales & support"
          title="Talk to Our Team"
          text="Quotes, distributor enquiries, datasheets or a technical question. Email us directly or use the form."
        />

        <a class="contact__mail" href={`mailto:${site.email}`} data-anim="up" data-anim-delay="0.2">
          <span class="contact__mail-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="M3 7l9 6 9-6" />
            </svg>
          </span>
          <span class="contact__mail-body">
            <span class="contact__mail-label">Email us</span>
            <span class="contact__mail-value">{site.email}</span>
          </span>
        </a>
      </aside>

      <div class="contact__form" data-anim="up">
        <h2 class="contact__form-title">Send an enquiry</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 4rem;
    align-items: start;
  }

  .contact__mail {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-block-start: 1rem;
    padding: 1.5rem;
    background: var(--color-bg-dark);
    border-radius: var(--radius-lg);
    color: var(--color-on-dark);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .contact__mail:hover,
  .contact__mail:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .contact__mail-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .contact__mail-icon svg { width: 1.5rem; height: 1.5rem; }
  .contact__mail-body { display: flex; flex-direction: column; min-width: 0; }
  .contact__mail-label { font-size: var(--text-sm); color: var(--color-on-dark-muted); }
  .contact__mail-value {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    overflow-wrap: anywhere;
  }

  .contact__form {
    padding: 2.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .contact__form-title { font-size: var(--text-h3); margin-block-end: 1.5rem; }

  @media (max-width: 991px) {
    .contact__grid { grid-template-columns: minmax(0, 1fr); gap: 3rem; }
  }
  @media (max-width: 575px) {
    .contact__form { padding: 1.5rem; }
  }
</style>
