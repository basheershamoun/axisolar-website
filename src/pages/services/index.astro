---
/** Services archive — banner, the six service cards and the call-us band. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import { site } from '../../data/site';
import { icons } from '../../data/services';

const whyUs = [
  { icon: 'gauge', title: 'Efficiency & Power', text: 'Systems sized on measured demand, so nothing you pay for sits idle.' },
  { icon: 'shield', title: 'Trust & Warranty', text: 'Twenty-five year module cover, with the paperwork kept valid for you.' },
  { icon: 'tools', title: 'High Quality Work', text: 'Directly employed, accredited engineers on every single install.' },
  { icon: 'headset', title: '24*7 Support', text: 'Remote monitoring and a real person on the phone, all year round.' },
];
---

<Base
  title="Our Services — Solor"
  description="Solar maintenance, PV systems, hybrid energy and whole-property renewable plans — designed, installed and supported by one team."
>
  <PageHero title="Our Services" crumbs={[{ label: 'Services' }]} />

  <ServicesGrid />

  <!-- ------------------------------------------------------- call band -->
  <section class="callband" aria-label="Contact us">
    <div class="container-site">
      <div class="callband__inner">
        <div class="callband__media">
          <img
            src="/images/service-cta.jpg"
            alt="Solor engineer surveying a rooftop installation"
            width="600"
            height="420"
            loading="lazy"
            decoding="async"
          />
          <span class="callband__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 6.1 6.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z" />
            </svg>
          </span>
        </div>
        <div class="callband__body">
          <h2 class="callband__title" data-anim="up">
            Have Questions? <span>Call Us</span>
            <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
          </h2>
          <p class="callband__text" data-anim="up" data-anim-delay="0.1">
            Tell us what your roof looks like and how you use power through the day. We will
            tell you plainly whether a system is worth it before anyone quotes you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ----------------------------------------------------- why choose us -->
  <section class="whyus section">
    <div class="container-site">
      <SectionHeading
        eyebrow="Why Choose Us"
        title="Providing Solar Energy Solutions"
        align="center"
      />
      <ul class="whyus__grid">
        {
          whyUs.map((item, i) => (
            <li class="whyus__item" data-anim="up" data-anim-delay={`${i * 0.1}`}>
              <span class="whyus__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[item.icon]}
                />
              </span>
              <h3 class="whyus__title">{item.title}</h3>
              <p class="whyus__text">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* --------------------------------------------------------- call band -- */
  .callband {
    padding-bottom: var(--section-py);
  }
  .callband__inner {
    display: grid;
    grid-template-columns: 18.75rem minmax(0, 1fr);
    align-items: center;
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
    overflow: hidden;
  }
  .callband__media {
    position: relative;
    align-self: stretch;
  }
  .callband__media img {
    width: 100%;
    height: 100%;
    min-height: 13.75rem;
    object-fit: cover;
  }
  .callband__icon {
    position: absolute;
    top: 50%;
    right: 0;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    transform: translate(50%, -50%);
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .callband__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .callband__body {
    padding: 2.5rem 2.5rem 2.5rem 4.375rem;
  }
  .callband__title {
    margin-bottom: 0.75rem;
    font-size: var(--text-h3);
    color: var(--color-heading);
  }
  .callband__title span {
    color: var(--color-accent);
  }
  .callband__title a:hover {
    color: var(--color-accent);
  }
  .callband__text {
    max-width: 40rem;
    color: var(--color-text);
  }

  /* ------------------------------------------------------ why choose us -- */
  .whyus {
    background: var(--color-bg-alt);
  }
  .whyus__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.875rem;
    margin-top: 3.125rem;
  }
  .whyus__item {
    padding: 2.125rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-align: center;
    transition: box-shadow var(--dur-fast) var(--ease-out);
  }
  .whyus__item:hover {
    box-shadow: var(--shadow-card);
  }
  .whyus__icon {
    display: grid;
    place-items: center;
    width: 4.375rem;
    height: 4.375rem;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .whyus__icon svg {
    width: 2rem;
    height: 2rem;
  }
  .whyus__title {
    margin-bottom: 0.5rem;
    font-size: var(--text-h5);
    color: var(--color-heading);
  }
  .whyus__text {
    font-size: var(--text-base);
    color: var(--color-text);
  }

  /* --------------------------------------------------------- responsive -- */
  @media (max-width: 991px) {
    .whyus__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .callband__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .callband__icon {
      top: auto;
      right: auto;
      left: 50%;
      bottom: 0;
      transform: translate(-50%, 50%);
    }
    .callband__body {
      padding: 3.125rem 1.5rem 2.25rem;
      text-align: center;
    }
  }

  @media (max-width: 575px) {
    .whyus__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
